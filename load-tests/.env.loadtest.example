# Copia este archivo a .env y completa los valores reales.
# El wrapper ./k6run lo carga automáticamente; el archivo .env está
# ignorado por git (.env*).

# URL del TCP desplegado en el servidor Linux (ajusta el puerto cuando montes la app)
BASE_URL=http://169.254.238.192:3000

# Usuario cajero del tenant demo (se crea desde el panel de administración)
EMAIL=cajero@demo.local
PASSWORD=cambia-esto

# ID del punto de venta del tenant demo (visible en la URL o en administración de puntos de venta)
PV_ID=

# Opcional: agrega la lista de precios del cliente al catálogo del POS
CLIENTE_ID=
