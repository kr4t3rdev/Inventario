generator client {
  provider  = "prisma-client-js"
  output    = "../src/generated/prisma"
  generator = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  catId                 String      @id @default(cuid())
  nombre                String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  descripcion           String?
  parentId              String?
  parent                Categoria?  @relation("CategoriaHierarchy", fields: [parentId], references: [catId], onDelete: Cascade)
  subcategorias         Categoria[] @relation("CategoriaHierarchy")
  productos             Producto[]
  productosSubcategoria Producto[]  @relation("ProductoSubcategoria")
}

model Unidad {
  unidadId  String     @id @default(cuid())
  nombre    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  simbolo   String
  productos Producto[]
}

model Vendor {
  vendorId        String           @id @default(cuid())
  vendorCode      String?          @unique @db.VarChar(2)
  nombre          String
  contacto        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  logo            String?
  contrato        String?
  cuentaCUP       String?
  cuentaUSD       String?
  direccion       String?
  telefono        String?
  compras         CompraProducto[]
  contratos       Contrato[]       @relation("ContratoVendor")
  cuentasPorPagar CuentaPorPagar[]
  deudasCash      DeudaCash[]
  gastoCompras    GastoCompra[]
  servicios       Servicios[]
  comprasServicios CompraServicio[]
  productos       Producto[]
  anticipos       Anticipo[]        @relation("AnticipoVendor")

  @@index([vendorCode])
}

model InyeccionCapital {
  id                 String         @id @default(cuid())
  tipo               TipoInyeccion
  montoRecibido      Decimal
  moneda             String         @default("CUP")
  tasaInteres        Decimal?
  montoInteres       Decimal?
  montoTotalDeuda    Decimal?
  saldoPendiente     Decimal?
  plazoMeses         Int?
  fechaInicioPago    DateTime?
  socio              String?
  entidadPrestamista String?
  cuentaId           String
  estado             EstadoDeuda?   @default(ACTIVA)
  descripcion        String?
  fechaRegistro      DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  cuentaBancaria     CuentaBancaria @relation(fields: [cuentaId], references: [cuentaId])
  pagos              PagoDeuda[]
}

model PagoDeuda {
  id             String           @id @default(cuid())
  inyeccionId    String
  montoPagado    Decimal
  fechaPago      DateTime         @default(now())
  cuentaId       String
  numeroCuota    Int?
  comprobante    String?
  observaciones  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cuentaBancaria CuentaBancaria   @relation(fields: [cuentaId], references: [cuentaId])
  inyeccion      InyeccionCapital @relation(fields: [inyeccionId], references: [id], onDelete: Cascade)
}

model Cliente {
  clienteId         String            @id @default(cuid())
  nombre            String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  direccion         String?
  numeroContrato    String?
  numeroCuentaCUP   String?
  numeroCuentaUSD   String?
  telefono          String?
  logoUrl           String?
  listaPrecioId     String?
  listaPrecio       ListaPrecio?      @relation(fields: [listaPrecioId], references: [id])
  contratos         Contrato[]        @relation("ContratoCliente")
  cuentasPorCobrar  CuentaPorCobrar[]
  prestamosCash     PrestamoCash[]
  ofertas           Oferta[]
  ordenesReparacion OrdenReparacion[]
  Venta             Venta[]
  ventasServicios   VentaServicios[]
  facturas          Factura[]
  anticipos         Anticipo[]        @relation("AnticipoCliente")
}

model MiEmpresa {
  id                Int             @id @default(1)
  nombre            String          @default("Mi Empresa")
  propietario       String?
  direccion         String?
  telefono          String?
  email             String?
  carnetIdentidad   String?
  nit               String?
  licenciaOperacion String?
  logoUrl                   String?
  cuentaBancariaId          String?         @unique
  nominaHorasMensuales      Int             @default(240)
  nominaFactorHorasExtras   Float           @default(1.5)
  nominaPorcentajeDeduccion Float           @default(10.0)
  nominaPorcentajeAporte    Float           @default(5.0)
  usaCodigoEan13            Boolean         @default(false)
  createdAt                 DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cuentaBancaria    CuentaBancaria? @relation("MiEmpresaCuenta", fields: [cuentaBancariaId], references: [cuentaId])
}

model Almacen {
  almacenId             String          @id @default(cuid())
  nombre                String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  productos             Producto[]
  transferenciasDestino Transferencia[] @relation("TransferenciasDestino")
  transferenciasOrigen  Transferencia[] @relation("TransferenciasOrigen")
}

model PuntoDeVenta {
  pvId                  String          @id @default(cuid())
  nombre                String
  ubicacion             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  listaPrecioId         String?
  listaPrecio           ListaPrecio?    @relation(fields: [listaPrecioId], references: [id])
  productos             Producto[]
  transferenciasDestino Transferencia[] @relation("TransferenciasDestino")
  transferenciasOrigen  Transferencia[] @relation("TransferenciasOrigen")
  ventas                Venta[]
}

model ListaPrecio {
  id            String           @id @default(cuid())
  nombre        String
  descripcion   String?
  esDefault     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  puntosDeVenta PuntoDeVenta[]
  precios       PrecioProducto[]
  clientes      Cliente[]
}

model PrecioProducto {
  id            String      @id @default(cuid())
  listaPrecioId String
  productoId    String
  precio        Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  listaPrecio   ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  producto      Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([listaPrecioId, productoId])
}

model StockUbicacion {
  stockId             String   @id @default(cuid())
  productoId          String
  tipoUbicacion       String
  ubicacionId         String
  cantidad            Int      @default(0)
  cantidadReservada   Int      @default(0)
  cantidadDisponible  Int      @default(0)
  ultimaActualizacion DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, tipoUbicacion, ubicacionId])
  @@index([productoId])
  @@index([tipoUbicacion, ubicacionId])
  @@index([ubicacionId])
}

model Producto {
  nombre          String
  descripcion     String?
  codigoInterno   String?                   @unique @db.VarChar(11)
  codigoNegocio   String?                   @unique @db.VarChar(40)
  proveedorCodigo String?                   @db.VarChar(2)
  idSeccionCodigo String?                   @db.VarChar(2)
  especificoCodigo String?                  @db.VarChar(4)
  surtidoCodigo   String?                   @db.VarChar(4)
  dcCodigo        String?                   @db.VarChar(1)
  precioCosto     Int
  precioVenta     Int
  stock           Int
  categoriaId     String
  unidadId        String?
  vendorId        String?
  createdAt       DateTime                  @default(now())
  id              String                    @id @default(cuid())
  updatedAt       DateTime                  @updatedAt
  deletedAt       DateTime?
  almacenId       String
  puntoDeVentaId  String?
  stockMinimo     Int                       @default(0)
  subcategoriaId  String?
  fotos           String[]                  @default([])
  // Campos para productos compuestos
  esCompuesto     Boolean                   @default(false)
  cantidadEnPack  Int?
  productoPadreId String?
  // Relaciones
  productoPadre   Producto?                  @relation("ProductoCompuesto", fields: [productoPadreId], references: [id], onDelete: Cascade)
  productosHijos  Producto[]                @relation("ProductoCompuesto")
  // Relaciones existentes
  compras         CompraProducto[]
  gastoCompras    GastoCompra[]
  mermas          Merma[]
  ofertaItems     OfertaItem[]
  ordenMateriales OrdenReparacionMaterial[]
  almacen         Almacen                   @relation(fields: [almacenId], references: [almacenId], onDelete: Cascade)
  categoria       Categoria                 @relation(fields: [categoriaId], references: [catId], onDelete: Cascade)
  puntoDeVenta    PuntoDeVenta?             @relation(fields: [puntoDeVentaId], references: [pvId], onDelete: Cascade)
  subcategoria    Categoria?                @relation("ProductoSubcategoria", fields: [subcategoriaId], references: [catId])
  unidad          Unidad?                   @relation(fields: [unidadId], references: [unidadId], onDelete: Cascade)
  vendor          Vendor?                   @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  stockUbicaciones StockUbicacion[]
  precios         PrecioProducto[]
  transferencias  Transferencia[]
  ventas          Venta[]
  ventaItems      VentaItem[]
  recetaIngredientes RecetaIngrediente[]
  receta          Receta?
  valeSalidaItems ValeSalidaItem[]

  @@index([deletedAt])
  @@index([esCompuesto])
  @@index([productoPadreId])
}

model Venta {
  ventaId          String                @id @default(cuid())
  productoId       String?
  cantidad         Int
  puntoDeVentaId   String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  empleadoId       String?
  total            Int?
  clienteId        String?
  ordenId          String?
  descuento        Int?
  observaciones    String?
  esVentaUnica     Boolean               @default(false)
  ofertaId         String?               @unique
  ventaPadreId     String?
  ordenReparacion  OrdenReparacion?      @relation("OrdenVenta")
  reconciliaciones ReconciliacionVenta[]
  cliente          Cliente?              @relation(fields: [clienteId], references: [clienteId], onDelete: Cascade)
  empleado         Empleado?             @relation(fields: [empleadoId], references: [empleadoId])
  oferta           Oferta?               @relation(fields: [ofertaId], references: [id])
  producto         Producto?             @relation(fields: [productoId], references: [id], onDelete: Cascade)
  puntoDeVenta     PuntoDeVenta          @relation(fields: [puntoDeVentaId], references: [pvId])
  factura          Factura?
  items            VentaItem[]
}

model VentaItem {
  id             String   @id @default(cuid())
  ventaId        String
  productoId     String
  cantidad       Int
  precioUnitario Int
  total          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  venta          Venta    @relation(fields: [ventaId], references: [ventaId], onDelete: Cascade)

  @@map("venta_items")
}

model Merma {
  mermaId    String   @id @default(cuid())
  productoId String
  cantidad   Int
  motivo     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  costoTotal Int?
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Transferencia {
  transferenciaId       String        @id @default(cuid())
  productoId            String
  cantidad              Int
  origenId              String?
  destinoId             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  descripcion           String?
  puntoDeVentaDestinoId String?
  puntoDeVentaOrigenId  String?
  costoUnitario         Int?
  costoTotal            Int?
  creadoPorId           String?
  deletedAt             DateTime?
  estado                String        @default("COMPLETADA")
  numeroTransferencia   String?       @unique
  creadoPor             User?         @relation(fields: [creadoPorId], references: [userId])
  destino               Almacen?      @relation("TransferenciasDestino", fields: [destinoId], references: [almacenId])
  origen                Almacen?      @relation("TransferenciasOrigen", fields: [origenId], references: [almacenId])
  producto              Producto      @relation(fields: [productoId], references: [id], onDelete: Cascade)
  puntoDeVentaDestino   PuntoDeVenta? @relation("TransferenciasDestino", fields: [puntoDeVentaDestinoId], references: [pvId])
  puntoDeVentaOrigen    PuntoDeVenta? @relation("TransferenciasOrigen", fields: [puntoDeVentaOrigenId], references: [pvId])

  @@index([estado])
  @@index([creadoPorId])
  @@index([createdAt])
  @@index([productoId])
  @@index([origenId])
  @@index([destinoId])
  @@index([deletedAt])
}

model User {
  userId               String               @id @default(cuid())
  name                 String
  email                String               @unique
  password             String
  role                 String               @default("regularUser")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  activatedAt          DateTime?
  avatar               String?
  expiresAt            DateTime?
  isActive             Boolean              @default(true)
  lastFailedLogin      DateTime?
  lastModifiedBy       String?
  lockedUntil          DateTime?
  loginAttempts        Int                  @default(0)
  comprasCreadas       CompraProducto[]     @relation("CompraProductoCreatedBy")
  comprasActualizadas  CompraProducto[]     @relation("CompraProductoUpdatedBy")
  comprasServiciosCreadas      CompraServicio[]     @relation("CompraServicioCreatedBy")
  comprasServiciosActualizadas CompraServicio[]     @relation("CompraServicioUpdatedBy")
  contratosAprobados   Contrato[]           @relation("AprobadorContrato")
  contratosCreados     Contrato[]           @relation("CreadorContrato")
  contratoAprobaciones ContratoAprobacion[]
  contratoArchivos     ContratoArchivo[]
  contratoFirmas       ContratoFirma[]
  contratoVersiones    ContratoVersion[]
  notifications        Notification[]
  transferencias       Transferencia[]
  activityLogs         UserActivityLog[]
  sessions             UserSession[]
  licencias            Licencia[]
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  userId    String
  prioridad String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model UserActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  details     String?
  ipAddress   String?
  userAgent   String?
  performedBy String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  ipAddress  String?
  userAgent  String?
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastActive DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model Attendance {
  attendanceId   String    @id @default(cuid())
  employeeId     String
  date           DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  totalHours     Decimal?  @db.Decimal(5, 2)
  status         String    @default("present")
  manualCheckIn  DateTime?
  manualCheckOut DateTime?
  isManualEntry  Boolean   @default(false)
  notes          String?
  scheduledHours Decimal?  @db.Decimal(4, 2)
  overtimeHours  Decimal?  @db.Decimal(4, 2)
  breakHours     Decimal?  @db.Decimal(3, 2)
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       Empleado  @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)
}

model EmployeeWorkSchedule {
  scheduleId     String   @id @default(cuid())
  employeeId     String
  dayOfWeek      Int
  startTime      String
  endTime        String
  breakStartTime String?
  breakEndTime   String?
  isWorkingDay   Boolean  @default(true)
  scheduledHours Decimal  @db.Decimal(4, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Empleado @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
}

model VacationRequest {
  requestId     String    @id @default(cuid())
  employeeId    String
  startDate     DateTime
  endDate       DateTime
  daysRequested Int
  reason        String?
  status        String    @default("pending")
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Empleado  @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)
}

/// *
/// * Modelo para registro de acumulación automática de vacaciones
model VacationAccrual {
  accrualId              String   @id @default(cuid())
  employeeId             String
  periodo                String
  diasAcumulados         Float
  diasPorAntiguedad      Int
  diasPorTiempoTrabajado Float
  tipoAcumulacion        String
  fechaCalculo           DateTime @default(now())
  procesado              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  employee               Empleado @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)
}

model Empleado {
  empleadoId            String                 @id @default(cuid())
  nombre                String
  apellido              String
  telefono              String?
  cargo                 String
  salarioBases          Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  diasVacacionesAnuales Int                    @default(15)
  esTiempoCompleto      Boolean                @default(true)
  fechaContratacion     DateTime
  fechaBaja             DateTime?
  motivoBaja            String?
  carnetIdentidad       String?
  vacationDaysAccrued   Float                  @default(0)
  vacationDaysUsed      Float                  @default(0)
  attendances           Attendance[]
  workSchedules         EmployeeWorkSchedule[]
  ordenesAsignadas      OrdenReparacion[]
  PagoSalario           Pagosalario[]
  vacationAccruals      VacationAccrual[]
  vacationRequests      VacationRequest[]
  ventas                Venta[]
  comandas              Comanda[]
}

model Pagosalario {
  pgId                String                @id @default(cuid())
  empleadoId          String
  salario             Int
  bonificaciones      Int?                  @default(0)
  deducciones         Int?                  @default(0)
  retenciones         Int?                  @default(0)
  aportes             Int?                  @default(0)
  horasExtras         Int?                  @default(0)
  observaciones       String?
  periodo             String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  empleado            Empleado              @relation(fields: [empleadoId], references: [empleadoId], onDelete: Cascade)
  ReconciliacionGasto ReconciliacionGasto[]
}

model CierreContable {
  cierreId            String   @id @default(cuid())
  tipo                String
  fechaInicio         DateTime
  fechaFin            DateTime
  totalVentas         Decimal  @default(0)
  totalGastos         Decimal  @default(0)
  ganancias           Decimal  @default(0)
  perdidas            Decimal  @default(0)
  ingresosCaja        Decimal  @default(0)
  egresosCaja         Decimal  @default(0)
  deudasClientes      Decimal  @default(0)
  deudasProveedores   Decimal  @default(0)
  inventarioVendido   Int      @default(0)
  inventarioRebajado  Int      @default(0)
  stockFinal          Int      @default(0)
  margenGanancia      Decimal  @default(0)
  margenPerdida       Decimal  @default(0)
  ventasVsExistencias String?
  estado              String   @default("abierto")
  creadoPor           String
  aprobadoPor         String?
  observaciones       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model GastoCompra {
  gastoCompraId    String                @id @default(cuid())
  productoId       String
  vendorId         String
  cantidad         Int
  precioUnitario   Int
  total            Int
  fechaCompra      DateTime              @default(now())
  descripcion      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  periodo          String?
  numeroFactura    String?
  deletedAt        DateTime?
  compraProducto   CompraProducto?
  cuentaPorPagar   CuentaPorPagar?
  producto         Producto              @relation(fields: [productoId], references: [id], onDelete: Cascade)
  vendor           Vendor                @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  reconciliaciones ReconciliacionGasto[]

  @@index([deletedAt])
}

model CompraProducto {
  compraProductoId String          @id @default(cuid())
  productoId       String
  proveedorId      String
  numeroFactura    String
  facturaUrl       String
  cantidad         Int
  precioUnitario   Int
  total            Int
  formaPago        String
  estado           String
  tipoOperacion    String          @default("REGULAR")
  descripcion      String?
  fechaCompra      DateTime        @default(now())
  gastoCompraId    String?         @unique
  cuentaPorPagarId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdById      String?
  deletedAt        DateTime?
  updatedById      String?
  createdBy        User?           @relation("CompraProductoCreatedBy", fields: [createdById], references: [userId])
  cuentaPorPagar   CuentaPorPagar? @relation(fields: [cuentaPorPagarId], references: [cuentaPorPagarId])
  gastoCompra      GastoCompra?    @relation(fields: [gastoCompraId], references: [gastoCompraId])
  producto         Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)
  proveedor        Vendor          @relation(fields: [proveedorId], references: [vendorId], onDelete: Cascade)
  updatedBy        User?           @relation("CompraProductoUpdatedBy", fields: [updatedById], references: [userId])

  @@index([estado])
  @@index([proveedorId])
  @@index([productoId])
  @@index([deletedAt])
}

model Servicios {
  servicioId      String           @id @default(cuid())
  nombre          String
  descripcion     String?
  codigoInterno   String?          @unique @db.VarChar(11)
  codigoNegocio   String?          @unique @db.VarChar(40)
  precioCosto     Int?
  precioVenta     Int?
  precio          Int              @default(0)
  categoriaId     String?
  subcategoriaId  String?
  unidadId        String?
  vendorId        String?
  activo          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  vendor          Vendor?          @relation(fields: [vendorId], references: [vendorId], onDelete: SetNull)
  ofertaItems     OfertaItem[]
  comprasServicios CompraServicio[]
  ventasServicios VentaServicios[]

  @@index([deletedAt])
  @@index([nombre])
  @@index([codigoNegocio])
  @@index([vendorId])
}

model CompraServicio {
  compraServicioId String    @id @default(cuid())
  servicioId       String
  proveedorId      String?
  numeroFactura    String?
  costoUnitario    Int
  cantidad         Int       @default(1)
  total            Int
  formaPago        String
  estado           String
  descripcion      String?
  fechaServicio    DateTime  @default(now())
  fechaVencimiento DateTime?
  createdById      String?
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        User?     @relation("CompraServicioCreatedBy", fields: [createdById], references: [userId])
  proveedor        Vendor?   @relation(fields: [proveedorId], references: [vendorId], onDelete: SetNull)
  servicio         Servicios @relation(fields: [servicioId], references: [servicioId], onDelete: Cascade)
  updatedBy        User?     @relation("CompraServicioUpdatedBy", fields: [updatedById], references: [userId])

  @@index([deletedAt])
  @@index([servicioId])
  @@index([proveedorId])
  @@index([estado])
}

model VentaServicios {
