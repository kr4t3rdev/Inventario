  totalGastos         Decimal  @default(0)
  ganancias           Decimal  @default(0)
  perdidas            Decimal  @default(0)
  ingresosCaja        Decimal  @default(0)
  egresosCaja         Decimal  @default(0)
  deudasClientes      Decimal  @default(0)
  deudasProveedores   Decimal  @default(0)
  inventarioVendido   Int      @default(0)
  inventarioRebajado  Int      @default(0)
  stockFinal          Int      @default(0)
  margenGanancia      Decimal  @default(0)
  margenPerdida       Decimal  @default(0)
