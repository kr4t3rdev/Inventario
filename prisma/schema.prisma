generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  catId                 String      @id @default(cuid())
  tenantId              String
  nombre                String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  descripcion           String?
  parentId              String?
  clasSectionId         String?
  clasSpecificId        String?
  parent                Categoria?  @relation("CategoriaHierarchy", fields: [parentId], references: [catId], onDelete: Cascade)
  subcategorias         Categoria[] @relation("CategoriaHierarchy")
  tenant                Tenant      @relation(fields: [tenantId], references: [tenantId])
  productos             Producto[]
  productosSubcategoria Producto[]  @relation("ProductoSubcategoria")

  @@index([clasSectionId])
  @@index([clasSpecificId])
  @@index([tenantId])
  @@index([tenantId, parentId])
}

model Unidad {
  unidadId  String     @id @default(cuid())
  nombre    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  simbolo   String
  tenantId  String
  productos Producto[]
  tenant    Tenant     @relation(fields: [tenantId], references: [tenantId])

  @@unique([tenantId, nombre])
  @@unique([tenantId, simbolo])
  @@index([tenantId])
}

model Vendor {
  vendorId         String            @id @default(cuid())
  tenantId         String
  nombre           String
  contacto         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contrato         String?
  cuentaCUP        String?
  cuentaUSD        String?
  direccion        String?
  logo             String?
  telefono         String?
  vendorCode       String?           @db.VarChar(2)
  anticipos        Anticipo[]
  compraDocumentos CompraDocumento[]
  ordenesCompra    OrdenCompra[]
  compras          CompraProducto[]
  compraServicios  CompraServicio[]
  contratos        Contrato[]        @relation("ContratoVendor")
  cuentasPorPagar  CuentaPorPagar[]
  deudasCash       DeudaCash[]
  gastoCompras     GastoCompra[]
  productos        Producto[]
  tenant           Tenant            @relation(fields: [tenantId], references: [tenantId])

  @@unique([tenantId, vendorCode])
  @@index([vendorCode])
  @@index([tenantId])
}

model InyeccionCapital {
  id                 String         @id @default(cuid())
  tenantId           String?
  tipo               TipoInyeccion
  montoRecibido      Decimal
  moneda             String         @default("CUP")
  tasaInteres        Decimal?
  montoInteres       Decimal?
  montoTotalDeuda    Decimal?
  saldoPendiente     Decimal?
  plazoMeses         Int?
  fechaInicioPago    DateTime?
  socio              String?
  entidadPrestamista String?
  cuentaId           String
  estado             EstadoDeuda?   @default(ACTIVA)
  descripcion        String?
  fechaRegistro      DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  cuentaBancaria     CuentaBancaria @relation(fields: [cuentaId], references: [cuentaId])
  pagos              PagoDeuda[]

  @@index([cuentaId, createdAt])
  @@index([tenantId])
}

model PagoDeuda {
  id             String           @id @default(cuid())
  tenantId       String?
  inyeccionId    String
  montoPagado    Decimal
  fechaPago      DateTime         @default(now())
  cuentaId       String
  numeroCuota    Int?
  comprobante    String?
  observaciones  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cuentaBancaria CuentaBancaria   @relation(fields: [cuentaId], references: [cuentaId])
  inyeccion      InyeccionCapital @relation(fields: [inyeccionId], references: [id], onDelete: Cascade)

  @@index([cuentaId, fechaPago])
  @@index([tenantId])
}

model Cliente {
  clienteId         String            @id @default(cuid())
  tenantId          String
  nombre            String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  direccion         String?
  logoUrl           String?
  numeroContrato    String?
  numeroCuentaCUP   String?
  numeroCuentaUSD   String?
  telefono          String?
  listaPrecioId     String?
  anticipos         Anticipo[]
  tenant            Tenant            @relation(fields: [tenantId], references: [tenantId])
  listaPrecio       ListaPrecio?      @relation(fields: [listaPrecioId], references: [id], onDelete: SetNull)
  contratos         Contrato[]        @relation("ContratoCliente")
  cuentasPorCobrar  CuentaPorCobrar[]
  ofertas           Oferta[]
  ordenesReparacion OrdenReparacion[]
  prestamosCash     PrestamoCash[]
  Venta             Venta[]
  ventasServicios   VentaServicios[]
  facturas          Factura[]

  @@index([tenantId])
  @@index([listaPrecioId])
}

/// * Modelo base de multi-tenant. Cada empresa/organización es un Tenant.
model Tenant {
  tenantId                       String                           @id @default(cuid())
  nombre                         String
  slug                           String?                          @unique
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  contabilidadTimezone           String                           @default("America/Argentina/Buenos_Aires")
  affiliateProfile               AffiliateProfile?
  affiliateCreditBalance         AffiliateCreditBalance?
  affiliatePerkGrants            AffiliatePerkGrant[]
  referralPerkRequests           ReferralPerkRequest[]
  referralsSent                  AffiliateReferral[]              @relation("ReferrerAffiliateReferrals")
  referralsReceived              AffiliateReferral[]              @relation("ReferredAffiliateReferrals")
  affiliateCommissionEntries     AffiliateCommissionLedger[]      @relation("ReferrerAffiliateCommissionEntries")
  salesAgentReferral             SalesAgentReferral?
  tenantLicensePayments          TenantLicensePayment[]
  ajustesBancarios               AjusteBancario[]
  almacenes                      Almacen[]
  anticipos                      Anticipo[]
  categorias                     Categoria[]
  cierresContables               CierreContable[]
  clientes                       Cliente[]
  comprasDocumento               CompraDocumento[]
  comprasDocumentoItem           CompraDocumentoItem[]
  comprasProducto                CompraProducto[]
  ordenesCompra                  OrdenCompra[]
  ordenesCompraItems             OrdenCompraItem[]
  recepcionesCompra              Recepcion[]
  recepcionesCompraItems         RecepcionItem[]
  reglasReabastecimiento         ReglaReabastecimiento[]
  comprasServicio                CompraServicio[]
  contratos                      Contrato[]
  cuentasBancarias               CuentaBancaria[]
  cuentasPorCobrar               CuentaPorCobrar[]
  cuentasPorPagar                CuentaPorPagar[]
  defectacionesCatalogo          DefectacionCatalogo[]
  deudasCash                     DeudaCash[]
  empleados                      Empleado[]
  equiposReparacion              EquipoReparacion[]
  gastosCompra                   GastoCompra[]
  gastosConceptos                GastoConcepto[]
  gastosDE                       GastosDE[]
  gastosElementos                GastoElemento[]
  listasPrecio                   ListaPrecio[]
  mermas                         Merma[]
  empresa                        MiEmpresa?
  ofertas                        Oferta[]
  ordenesProduccion              OrdenProduccion[]
  ordenesProduccionHistorial     OrdenProduccionHistorial[]
  ordenesReparacion              OrdenReparacion[]
  ordenesReparacionEquipo        OrdenReparacionEquipo[]
  ordenesReparacionItem          OrdenReparacionItem[]
  ordenesReparacionMaterial      OrdenReparacionMaterial[]
  pagosCuentaPorPagar            PagoCuentaPorPagar[]
  pagosSalario                   Pagosalario[]
  piezasReparacion               PiezaReparacion[]
  prestamosCash                  PrestamoCash[]
  productos                      Producto[]
  puntosDeVenta                  PuntoDeVenta[]
  recetas                        Receta[]
  recetasIngredientes            RecetaIngrediente[]
  reconciliacionesGasto          ReconciliacionGasto[]
  reconciliacionesServicio       ReconciliacionServicio[]
  reconciliacionesVenta          ReconciliacionVenta[]
  servicios                      Servicios[]
  stockUbicaciones               StockUbicacion[]
  transferencias                 Transferencia[]
  transferenciasBancarias        TransferenciaBancaria[]
  unidades                       Unidad[]
  valesSalida                    ValeSalida[]
  valesSalidaItem                ValeSalidaItem[]
  vendors                        Vendor[]
  ventas                         Venta[]
  ventasServicios                VentaServicios[]
  aperturaPeriodos               AperturaPeriodo[]
  arqueosCaja                    ArqueoCaja[]
  auditoriaPeriodos              AuditoriaPeriodo[]
  backupLogs                     BackupLog[]
  backupPlans                    BackupPlan[]
  facturas                       Factura[]
  periodosContables              PeriodoContable[]
  purchaseAllocations            PurchaseAllocation[]
  reviewPrompts                  ReviewPrompt[]
  reviews                        Review[]
  seriesFacturacion              SerieFacturacion[]
  licencias                      TenantLicense[]
  memberships                    TenantMembership[]
  tenantRoles                    TenantRole[]
  accountingPolicy               TenantAccountingPolicy?
  accountingPolicyRolloutEntries AccountingPolicyRolloutEntry[]
  accountingPolicyApprovals      AccountingPolicyTenantApproval[]
  fxEvidence                     FxEvidence[]
  financialAuxiliaryCheckpoints  FinancialAuxiliaryCheckpoint[]
  snapshotPeriodos               SnapshotPeriodo[]
  stockMoveLines                 StockMoveLine[]
  ajustesInventario              AjusteInventario[]
  conteosInventario              ConteoInventario[]
  turnosPos                      TurnoPuntoVenta[]
  tiposPago                      TipoPago[]

  @@index([slug])
  @@map("tenants")
}

/// * Membresía de un usuario en un tenant. Desacopla identidad global de rol operativo.
model TenantMembership {
  membershipId String      @id @default(cuid())
  tenantId     String
  userId       String
  tenantRole   String      @default("dependiente")
  customRoleId String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenant       Tenant      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [userId], onDelete: Cascade)
  customRole   TenantRole? @relation(fields: [customRoleId], references: [roleId], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@index([customRoleId])
  @@map("tenant_memberships")
}

/// * Rol personalizado de tenant: conjunto de permisos nombrados asignable a membresías.
/// `permissions` es un string[] validado contra permission-registry al escribir.
/// Sin filas, el sistema opera 100% por defaults del registry (customRoleId = null).
model TenantRole {
  roleId      String             @id @default(cuid())
  tenantId    String
  nombre      String
  descripcion String?
  permissions Json
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  memberships TenantMembership[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
  @@map("tenant_roles")
}

/// * Licencia/plan activo de un tenant. Reemplaza la relación actual Licencia→User.
model TenantLicense {
  tenantLicenseId             String                       @id @default(cuid())
  tenantId                    String
  planId                      String?
  activa                      Boolean                      @default(true)
  inicio                      DateTime                     @default(now())
  expiracion                  DateTime
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  maxUsuarios                 Int                          @default(1)
  maxAlmacenes                Int                          @default(1)
  maxProductos                Int                          @default(100)
  maxClientes                 Int                          @default(200)
  listPriceUsd                Decimal?                     @db.Decimal(10, 2)
  creditAppliedUsd            Decimal?                     @db.Decimal(10, 2)
  finalPriceUsd               Decimal?                     @db.Decimal(10, 2)
  creditSnapshotUsd           Decimal?                     @db.Decimal(10, 2)
  features                    Json?
  featureOverrides            Json?
  isDemo                      Boolean                      @default(false)
  isAdminTest                 Boolean                      @default(false)
  createdBy                   String?
  plan                        Plan?                        @relation(fields: [planId], references: [planId])
  tenant                      Tenant                       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  confirmedAffiliateReferrals AffiliateReferral[]          @relation("ConfirmedAffiliateLicense")
  sourceAffiliateCommissions  AffiliateCommissionLedger[]  @relation("AffiliateSourceLicense")
  appliedAffiliateCommissions AffiliateCommissionLedger[]  @relation("AffiliateAppliedLicense")
  salesAgentCommissionEntries SalesAgentCommissionLedger[] @relation("SalesAgentSourceLicense")
  salesAgentPayments          TenantLicensePayment[]

  @@index([tenantId])
  @@index([planId])
  @@map("tenant_licenses")
}

model MiEmpresa {
  id                Int             @id @default(autoincrement())
  tenantId          String?         @unique
  nombre            String          @default("Mi Empresa")
  propietario       String?
  direccion         String?
  telefono          String?
  email             String?
  carnetIdentidad   String?
  nit               String?
  licenciaOperacion String?
  logoUrl           String?
  cuentaBancariaId  String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  usaCodigoEan13    Boolean         @default(false)
  cuentaBancaria    CuentaBancaria? @relation("MiEmpresaCuenta", fields: [cuentaBancariaId], references: [cuentaId])
  tenant            Tenant?         @relation(fields: [tenantId], references: [tenantId])
}

model Almacen {
  almacenId             String          @id @default(cuid())
  tenantId              String
  nombre                String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  tenant                Tenant          @relation(fields: [tenantId], references: [tenantId])
  mermas                Merma[]
  productos             Producto[]
  puntosDeVenta         PuntoDeVenta[]
  transferenciasDestino Transferencia[] @relation("TransferenciasDestino")
  transferenciasOrigen  Transferencia[] @relation("TransferenciasOrigen")

  @@index([tenantId])
}

model PuntoDeVenta {
  pvId                  String            @id @default(cuid())
  tenantId              String
  nombre                String
  ubicacion             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  listaPrecioId         String?
  almacenId             String?
  cuentaContableId      String?
  tipoCaja              String?           @default("PRINCIPAL")
  productos             Producto[]
  almacen               Almacen?          @relation(fields: [almacenId], references: [almacenId], onDelete: Restrict)
  listaPrecio           ListaPrecio?      @relation(fields: [listaPrecioId], references: [id])
  tenant                Tenant            @relation(fields: [tenantId], references: [tenantId])
  transferenciasDestino Transferencia[]   @relation("TransferenciasDestino")
  transferenciasOrigen  Transferencia[]   @relation("TransferenciasOrigen")
  ventas                Venta[]
  arqueos               ArqueoCaja[]
  turnos                TurnoPuntoVenta[]

  @@index([tenantId])
}

model TurnoPuntoVenta {
  id              String       @id @default(cuid())
  tenantId        String
  puntoDeVentaId  String
  empleadoId      String?
  tipo            String       @default("NORMAL")
  fechaApertura   DateTime     @default(now())
  fechaCierre     DateTime?
  fondoInicialCup Int          @default(0)
  fondoInicialUsd Int          @default(0)
  estado          EstadoTurno  @default(ABIERTO)
  observaciones   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  ventas          Venta[]
  arqueos         ArqueoCaja[]
  empleado        Empleado?    @relation(fields: [empleadoId], references: [empleadoId])
  puntoDeVenta    PuntoDeVenta @relation(fields: [puntoDeVentaId], references: [pvId])
  tenant          Tenant       @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
  @@index([puntoDeVentaId, fechaApertura])
  @@map("turnos_punto_venta")
}

model ArqueoCaja {
  id                    String          @id @default(cuid())
  turnoId               String
  tenantId              String
  puntoDeVentaId        String
  billetes1000Cup       Int             @default(0)
  billetes500Cup        Int             @default(0)
  billetes200Cup        Int             @default(0)
  billetes100Cup        Int             @default(0)
  billetes50Cup         Int             @default(0)
  billetes20Cup         Int             @default(0)
  monedasCup            Int             @default(0)
  billetes100Usd        Int             @default(0)
  billetes50Usd         Int             @default(0)
  billetes20Usd         Int             @default(0)
  billetes10Usd         Int             @default(0)
  billetes5Usd          Int             @default(0)
  billetes1Usd          Int             @default(0)
  monedasUsd            Int             @default(0)
  totalEfectivoCup      Int             @default(0)
  totalEfectivoUsd      Int             @default(0)
  totalTarjeta          Int             @default(0)
  totalTransferencia    Int             @default(0)
  totalCredito          Int             @default(0)
  esperadoEfectivoCup   Int             @default(0)
  esperadoEfectivoUsd   Int             @default(0)
  esperadoTarjeta       Int             @default(0)
  esperadoTransferencia Int             @default(0)
  esperadoCredito       Int             @default(0)
  diferenciaCup         Int             @default(0)
  diferenciaUsd         Int             @default(0)
  observaciones         String?
  contabilizado         Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  billetes10Cup         Int             @default(0)
  billetes1Cup          Int             @default(0)
  billetes5Cup          Int             @default(0)
  puntoDeVenta          PuntoDeVenta    @relation(fields: [puntoDeVentaId], references: [pvId])
  tenant                Tenant          @relation(fields: [tenantId], references: [tenantId])
  turno                 TurnoPuntoVenta @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([puntoDeVentaId])
  @@map("arqueos_caja")
}

model Producto {
  nombre               String
  tenantId             String
  descripcion          String?
  precioCosto          Int
  precioVenta          Int
  stock                Int
  categoriaId          String
  unidadId             String?
  vendorId             String?
  createdAt            DateTime                  @default(now())
  id                   String                    @id @default(cuid())
  updatedAt            DateTime                  @updatedAt
  esCompuesto          Boolean                   @default(false)
  almacenId            String
  puntoDeVentaId       String?
  stockMinimo          Int                       @default(0)
  subcategoriaId       String?
  cantidadEnPack       Int?
  productoPadreId      String?
  codigoInterno        String?                   @db.VarChar(11)
  codigoNegocio        String?
  proveedorCodigo      String?
  idSeccionCodigo      String?
  especificoCodigo     String?
  surtidoCodigo        String?
  dcCodigo             String?
  fotos                String[]                  @default([])
  compraDocumentoItems CompraDocumentoItem[]
  ordenCompraItems     OrdenCompraItem[]
  recepcionItems       RecepcionItem[]
  reglasReabastecimiento ReglaReabastecimiento[]
  compras              CompraProducto[]
  gastoCompras         GastoCompra[]
  mermas               Merma[]
  ofertaItems          OfertaItem[]
  ordenMateriales      OrdenReparacionMaterial[]
  precios              PrecioProducto[]
  almacen              Almacen                   @relation(fields: [almacenId], references: [almacenId], onDelete: Restrict)
  categoria            Categoria                 @relation(fields: [categoriaId], references: [catId], onDelete: Cascade)
  productoPadre        Producto?                 @relation("ProductoCompuesto", fields: [productoPadreId], references: [id])
  productosHijos       Producto[]                @relation("ProductoCompuesto")
  puntoDeVenta         PuntoDeVenta?             @relation(fields: [puntoDeVentaId], references: [pvId], onDelete: Cascade)
  subcategoria         Categoria?                @relation("ProductoSubcategoria", fields: [subcategoriaId], references: [catId])
  tenant               Tenant                    @relation(fields: [tenantId], references: [tenantId])
  unidad               Unidad?                   @relation(fields: [unidadId], references: [unidadId], onDelete: Restrict)
  vendor               Vendor?                   @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  costHistory          ProductoCostHistory[]
  Receta               Receta[]
  RecetaIngrediente    RecetaIngrediente[]
  stockUbicaciones     StockUbicacion[]
  stockMoveLines       StockMoveLine[]
  transferencias       Transferencia[]
  ValeSalidaItem       ValeSalidaItem[]
  ventas               Venta[]
  ventaItems           VentaItem[]

  @@unique([tenantId, codigoInterno])
  @@unique([tenantId, codigoNegocio])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, categoriaId])
  @@index([tenantId, vendorId])
  @@index([tenantId, subcategoriaId])
}

model StockUbicacion {
  id                 String   @id @default(cuid())
  tenantId           String
  productoId         String
  tipoUbicacion      String
  ubicacionId        String
  cantidad           Int      @default(0)
  cantidadReservada  Int      @default(0)
  cantidadDisponible Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  producto           Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tenant             Tenant   @relation(fields: [tenantId], references: [tenantId])

  @@unique([productoId, tipoUbicacion, ubicacionId])
  @@index([tenantId])
  @@index([ubicacionId, tipoUbicacion])
  @@index([productoId])
}

/// Ajuste unificado de inventario con motivo de catálogo y valorización.
/// Reemplaza lógicamente a Merma/ValeSalida; ambos crean un ajuste equivalente
/// para mantener trazabilidad contable y proponer compensación en kardex.
model AjusteInventario {
  id                   String        @id @default(cuid())
  tenantId             String
  productoId           String
  tipoUbicacion        String
  ubicacionId          String
  motivo               String
  cantidadTeorica      Int
  cantidadContada      Int
  diferencia           Int
  costoUnitario        Int
  costoTotal           Int
  estado               String        @default("APLICADO")
  origenMermaId        String?
  origenValeId         String?
  origenConteoId       String?
  compensaMovimientoId String?
  creadoPorId          String?
  createdAt            DateTime      @default(now())
  tenant               Tenant        @relation(fields: [tenantId], references: [tenantId])
  conteoLineas         ConteoLinea[]

  @@index([tenantId, estado])
  @@index([tenantId, productoId])
  @@index([tenantId, origenConteoId])
}

/// Conteo físico de una ubicación con doble pasada ciega y conciliación.
model ConteoInventario {
  id              String        @id @default(cuid())
  tenantId        String
  tipoUbicacion   String
  ubicacionId     String
  estado          String        @default("BORRADOR")
  observaciones   String?
  iniciadoPorId   String?
  conciliadoPorId String?
  conciliadoAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [tenantId])
  lineas          ConteoLinea[]

  @@index([tenantId, estado])
  @@index([tenantId, ubicacionId])
}

/// Línea de producto dentro de un conteo ciego en dos pasadas.
model ConteoLinea {
  id           String            @id @default(cuid())
  conteoId     String
  tenantId     String
  productoId   String
  teorico      Int
  conteo1      Int?
  conteo2      Int?
  contadoFinal Int?
  usuario1Id   String?
  usuario2Id   String?
  ajusteId     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  conteo       ConteoInventario  @relation(fields: [conteoId], references: [id], onDelete: Cascade)
  ajuste       AjusteInventario? @relation(fields: [ajusteId], references: [id], onDelete: SetNull)

  @@unique([conteoId, productoId])
  @@index([tenantId])
}

/// Movimiento apendicular del kardex. Las correcciones se representan
/// con un movimiento compensatorio, nunca editando este registro.
/// La clave `eventoKey` hace idempotente la escritura (upsert): un retry
/// del mismo evento de negocio no duplica la línea.
model StockMoveLine {
  id               String               @id @default(cuid())
  tenantId         String
  productoTenantId String
  productoId       String
  tipoOrigen       TipoOrigenMovimiento
  origenId         String
  tipoUbicacion    String
  ubicacionId      String
  cantidad         Int
  costoUnitario    Int
  costoTotal       Int
  secuencia        String               @default("0")
  creadoPorId      String?
  createdAt        DateTime             @default(now())
  tenant           Tenant               @relation(fields: [tenantId], references: [tenantId])
  producto         Producto             @relation(fields: [productoTenantId, productoId], references: [tenantId, id], onDelete: Restrict)
  creadoPor        User?                @relation(fields: [creadoPorId], references: [userId], onDelete: SetNull)

  @@unique([tenantId, tipoOrigen, origenId, productoId, tipoUbicacion, ubicacionId, secuencia], name: "eventoKey")
  @@index([tenantId, productoId, createdAt])
  @@index([tenantId, tipoOrigen, origenId])
  @@index([tenantId, ubicacionId, createdAt, id])
}

model Venta {
