model CategoriaPlato {
  categoriaPlatoId String   @id @default(cuid())
  nombre           String
  descripcion     String?
  orden            Int      @default(0)
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  platos           Plato[]
}

model Plato {
  platoId            String         @id @default(cuid())
  nombre             String
  descripcion        String?
  precio             Int
  imagen             String?
  disponible         Boolean        @default(true)
  tipoPlato          TipoPlato
  esElaborado        Boolean        @default(false)
  categoriaPlatoId  String?
  recetaId           String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  categoriaPlato     CategoriaPlato? @relation(fields: [categoriaPlatoId], references: [categoriaPlatoId])
  receta             Receta?        @relation(fields: [recetaId], references: [recetaId])
  comandaItems       ComandaItem[]
}

model Receta {
  recetaId        String            @id @default(cuid())
  nombre          String
  rendimiento    Int               @default(1)
  costoUnitario  Int               @default(0)
  instrucciones   String?
  tiempoPrep     Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  plato          Plato?
  producto       Producto?          @relation(fields: [productoId], references: [id])
  productoId     String?            @unique
  ingredientes   RecetaIngrediente[]
  ordenesProduccion OrdenProduccion[]
}

model RecetaIngrediente {
  recetaIngredienteId String   @id @default(cuid())
  recetaId           String
  productoId         String
  cantidad           Float
  desperdicio        Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  receta             Receta   @relation(fields: [recetaId], references: [recetaId], onDelete: Cascade)
  producto           Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([recetaId, productoId])
}

model Mesa {
  mesaId      String      @id @default(cuid())
  numero      Int         @unique
  capacidad   Int         @default(4)
  estado      EstadoMesa  @default(DISPONIBLE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  comandas   Comanda[]
}

model Comanda {
  comandaId       String         @id @default(cuid())
  mesaId          String
  empleadoId      String?
  estado          EstadoComanda  @default(ABIERTA)
  total           Int            @default(0)
  observaciones   String?
  fechaApertura   DateTime       @default(now())
  fechaCierre     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  mesa            Mesa           @relation(fields: [mesaId], references: [mesaId])
  empleado        Empleado?      @relation(fields: [empleadoId], references: [empleadoId])
  items           ComandaItem[]
}

model ComandaItem {
  comandaItemId String            @id @default(cuid())
  comandaId     String
  platoId       String
  cantidad      Int
  precioUnitario Int
  notas         String?
  estado        EstadoComandaItem @default(PENDIENTE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  comanda       Comanda           @relation(fields: [comandaId], references: [comandaId], onDelete: Cascade)
  plato         Plato             @relation(fields: [platoId], references: [platoId])
}

model OrdenProduccion {
  ordenProduccionId String           @id @default(cuid())
  recetaId         String
  cantidad         Int
  estado           EstadoProduccion @default(PENDIENTE)
  observaciones    String?
  fechaProduccion  DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  costoMateriales  Int?
  costoUnitario    Int?
  receta           Receta           @relation(fields: [recetaId], references: [recetaId])
}

model NominaConfig {
  configId              String   @id @default(cuid())
  periodo               String   @unique // YYYY-MM
  vacacionesPorcentaje  Float    @default(9.09)
  impuesto3Porcentaje   Float    @default(3.0)
  impuesto5Porcentaje   Float    @default(5.0)
  impuesto12_5Porcentaje Float   @default(12.5)
  impuesto1_5Porcentaje  Float   @default(1.5)
  aplicar12_5y1_5       Boolean  @default(true) // Cambiado a true por defecto
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Plan {
  planId           String     @id @default(cuid())
  nombre           String
  descripcion      String?
  precio           Decimal    @default(0) @db.Decimal(10, 2)
  duracionDias     Int        @default(30)
  funcionalidades  Json?
  maxUsuarios      Int        @default(1)
  maxAlmacenes     Int        @default(1)
  maxProductos     Int        @default(100)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  licencias        Licencia[]
}

model Licencia {
  licenciaId   String    @id @default(cuid())
  clave        String    @unique
  usuarioId    String
  planId       String
  activa       Boolean   @default(true)
  inicio       DateTime  @default(now())
  expiracion   DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  usuario      User      @relation(fields: [usuarioId], references: [userId], onDelete: Cascade)
  plan         Plan      @relation(fields: [planId], references: [planId])

  @@index([usuarioId])
  @@index([clave])
  auditorias   LicenciaAudit[]
}

model LicenciaAudit {
  auditId      String   @id @default(cuid())
  licenciaId   String
  accion       String   // "CREACION", "REVOCACION", "ACTIVACION", "VALIDACION_FALLIDA", "VALIDACION_EXITOSA"
  detalles     String?  // JSON string con detalles extra
  realizadoPor String?  // ID del usuario que realizó la acción (si aplica)
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  
  licencia     Licencia @relation(fields: [licenciaId], references: [licenciaId], onDelete: Cascade)

  @@index([licenciaId])
  @@index([accion])
  @@index([createdAt])
}

// ============================================
// MODELOS DE PRODUCCIÓN
// ============================================

model ValeSalida {
  valeSalidaId   String           @id @default(cuid())
  concepto       String
  observaciones String?
  estado         String           @default("pendiente")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  usuarioId      String
  items          ValeSalidaItem[]

  @@index([estado])
  @@index([createdAt])
  @@index([usuarioId])
}

model ValeSalidaItem {
  valeSalidaItemId String     @id @default(cuid())
  valeSalidaId     String
  productoId       String
  cantidad         Int
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  valeSalida       ValeSalida @relation(fields: [valeSalidaId], references: [valeSalidaId], onDelete: Cascade)
  producto         Producto   @relation(fields: [productoId], references: [id])

  @@index([valeSalidaId])
  @@index([productoId])
}

model OrdenProduccionHistorial {
  historialId       String   @id @default(cuid())
  ordenProduccionId String
  estadoAnterior     String?
  estadoNuevo       String
  observaciones     String?
  usuarioId         String
  createdAt         DateTime @default(now())

  @@index([ordenProduccionId])
  @@index([createdAt])
}

model VendorCodeSequence {
  id          Int      @id @default(1)
  nextNumber  Int      @default(1)
  updatedAt   DateTime @updatedAt
}

// ─── Cash Loans & Debts ────────────────────────────────────────────────────────

model PrestamoCash {
  id                String              @id @default(cuid())
  idNumerico        Int                 @default(autoincrement())
  clienteId         String
  cuentaPorCobrarId String              @unique
  montoCapital      Decimal
  moneda            String              @default("CUP")
  tasaInteres       Decimal?
  tasaCambioAlCrear Decimal?
  fechaOtorgamiento DateTime            @default(now())
  fechaVencimiento  DateTime?
  estado            EstadoPrestamoCash  @default(ACTIVO)
  observaciones     String?
  createdById       String
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cliente           Cliente             @relation(fields: [clienteId], references: [clienteId])
  cuentaPorCobrar   CuentaPorCobrar     @relation(fields: [cuentaPorCobrarId], references: [id])

  @@index([clienteId, estado])
  @@index([estado, fechaVencimiento])
}

model DeudaCash {
  id                String             @id @default(cuid())
  idNumerico        Int                @default(autoincrement())
  proveedorId       String
  cuentaPorPagarId  String             @unique
  montoCapital      Decimal
  moneda            String             @default("CUP")
  tasaInteres       Decimal?
  fechaOtorgamiento DateTime           @default(now())
  fechaVencimiento  DateTime?
  estado            EstadoPrestamoCash @default(ACTIVO)
  observaciones     String?
  createdById       String
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  proveedor         Vendor             @relation(fields: [proveedorId], references: [vendorId])
  cuentaPorPagar    CuentaPorPagar     @relation(fields: [cuentaPorPagarId], references: [cuentaPorPagarId])

  @@index([proveedorId, estado])
  @@index([estado, fechaVencimiento])
}

enum CuentaPorCobrarTipo {
  VENTA
  PRESTAMO_CASH
}

enum CuentaPorPagarTipo {
  COMPRA
  DEUDA_CASH
}

enum TipoReconciliacion {
  VENTA
  PRESTAMO_CASH
  DEUDA_CASH
}

enum EstadoPrestamoCash {
  ACTIVO
  PAGADO
  VENCIDO
  CANCELADO
}
