  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
}

model GastoCompra {
  gastoCompraId    String                @id @default(cuid())
  tenantId         String
  productoId       String
  vendorId         String
  cantidad         Int
  precioUnitario   Int
  total            Int
