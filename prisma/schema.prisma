model SalesAgentCommissionLedger {
  salesAgentCommissionLedgerId String               @id @default(cuid())
  salesAgentUserId             String
  salesAgentReferralId         String
  sourceTenantLicenseId        String
  paymentSource                String
  paymentSourceId              String               @unique
  idempotencyKey               String               @unique
  amountPaidUsd                Decimal              @db.Decimal(12, 2)
  commissionRate               Decimal              @db.Decimal(5, 4)
  commissionAmountUsd          Decimal              @db.Decimal(12, 2)
  status                       String               @default("available")
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  salesAgent                   User                 @relation("SalesAgentCommissionOwner", fields: [salesAgentUserId], references: [userId], onDelete: Restrict)
  referral                     SalesAgentReferral   @relation(fields: [salesAgentReferralId], references: [salesAgentReferralId], onDelete: Restrict)
  sourceTenantLicense          TenantLicense        @relation("SalesAgentSourceLicense", fields: [sourceTenantLicenseId], references: [tenantLicenseId], onDelete: Restrict)
  paymentConfirmation          TenantLicensePayment @relation(fields: [paymentSourceId], references: [tenantLicensePaymentId], onDelete: Restrict)

  @@unique([paymentSource, paymentSourceId])
  @@index([salesAgentUserId, status])
  @@index([salesAgentReferralId])
  @@index([sourceTenantLicenseId])
}

model TenantLicensePayment {
