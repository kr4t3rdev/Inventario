  stockFinal          Int      @default(0)
  margenGanancia      Decimal  @default(0)
  margenPerdida       Decimal  @default(0)
  ventasVsExistencias String?
  estado              String   @default("abierto")
  creadoPor           String
  aprobadoPor         String?
  observaciones       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
}

model GastoCompra {
  gastoCompraId    String                @id @default(cuid())
  tenantId         String
  productoId       String
  vendorId         String
  cantidad         Int
  precioUnitario   Int
  total            Int
  fechaCompra      DateTime              @default(now())
  descripcion      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  periodo          String?
  numeroFactura    String?
  deletedAt        DateTime?
  compraDocumento  CompraDocumento?
  compraProducto   CompraProducto?
  cuentaPorPagar   CuentaPorPagar?
  producto         Producto              @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tenant           Tenant                @relation(fields: [tenantId], references: [tenantId])
  vendor           Vendor                @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  reconciliaciones ReconciliacionGasto[]

  @@index([tenantId])
}

model CompraProducto {
  compraProductoId String          @id @default(cuid())
  tenantId         String
  productoId       String
  numeroFactura    String
  facturaUrl       String
  cantidad         Int
  precioUnitario   Int
  total            Int
  descripcion      String?
  fechaCompra      DateTime        @default(now())
  gastoCompraId    String?         @unique
  cuentaPorPagarId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  proveedorId      String
  formaPago        String
  estado           String
  tipoOperacion    String          @default("REGULAR")
  deletedAt        DateTime?
  updatedById      String?
  anticipo         Anticipo?
  cuentaPorPagar   CuentaPorPagar? @relation(fields: [cuentaPorPagarId], references: [cuentaPorPagarId])
  gastoCompra      GastoCompra?    @relation(fields: [gastoCompraId], references: [gastoCompraId])
  producto         Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)
  proveedor        Vendor          @relation(fields: [proveedorId], references: [vendorId], onDelete: Cascade)
  tenant           Tenant          @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
  @@index([estado])
  @@index([proveedorId])
  @@index([productoId])
  @@index([deletedAt])
}

/// * Cabecera de compra múltiple. Una factura/proveedor → N items.
model CompraDocumento {
  compraDocumentoId String                @id @default(cuid())
  tenantId          String
  proveedorId       String
  numeroFactura     String                @default("")
  facturaUrl        String                @default("")
  formaPago         String
  estado            String
  tipoOperacion     String                @default("REGULAR")
  descripcion       String?
  fechaCompra       DateTime              @default(now())
  total             Int                   @default(0)
  gastoCompraId     String?               @unique
  cuentaPorPagarId  String?               @unique
  ordenCompraId     String?
  deletedAt         DateTime?
  claveIdempotencia String?
  updatedById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  cuentaPorPagar    CuentaPorPagar?       @relation(fields: [cuentaPorPagarId], references: [cuentaPorPagarId])
  gastoCompra       GastoCompra?          @relation(fields: [gastoCompraId], references: [gastoCompraId])
  proveedor         Vendor                @relation(fields: [proveedorId], references: [vendorId], onDelete: Cascade)
  tenant            Tenant                @relation(fields: [tenantId], references: [tenantId])
  updatedBy         User?                 @relation("CompraDocumentoActualizado", fields: [updatedById], references: [userId])
  items             CompraDocumentoItem[]
  ordenCompra       OrdenCompra?           @relation(fields: [tenantId, ordenCompraId], references: [tenantId, id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([tenantId, claveIdempotencia])
  @@index([tenantId])
  @@index([estado])
  @@index([proveedorId])
  @@index([fechaCompra])
  @@index([deletedAt])
  @@index([tenantId, ordenCompraId])
}

/// * Línea de detalle de una compra múltiple.
model CompraDocumentoItem {
  compraDocumentoItemId String               @id @default(cuid())
  tenantId              String
  compraDocumentoId     String
  productoId            String
  cantidad              Int
  precioUnitario        Int
  totalLinea            Int
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  compraDocumento       CompraDocumento      @relation(fields: [compraDocumentoId], references: [compraDocumentoId], onDelete: Cascade)
  producto              Producto             @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tenant                Tenant               @relation(fields: [tenantId], references: [tenantId])
  allocations           PurchaseAllocation[]

  @@index([tenantId])
  @@index([compraDocumentoId])
  @@index([productoId])
}

/// Pedido a proveedor antes de recibir la mercancía.
model OrdenCompra {
  id          String             @id @default(cuid())
  tenantId    String
  proveedorId String
  estado      String             @default("BORRADOR")
  total       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [tenantId])
  proveedor   Vendor             @relation(fields: [proveedorId], references: [vendorId], onDelete: Restrict)
  items       OrdenCompraItem[]
  recepciones Recepcion[]
  facturas    CompraDocumento[]

  @@unique([tenantId, id])
  @@index([tenantId, estado])
  @@index([tenantId, proveedorId])
}

/// Línea de OC con cantidades pedidas y recibidas acumuladas.
model OrdenCompraItem {
  id               String          @id @default(cuid())
  ordenId          String
  tenantId         String
  productoId       String
  cantidadPedida   Int
  cantidadRecibida Int             @default(0)
  precioUnitario   Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  orden            OrdenCompra     @relation(fields: [tenantId, ordenId], references: [tenantId, id], onDelete: Cascade)
  producto         Producto        @relation(fields: [tenantId, productoId], references: [tenantId, id], onDelete: Restrict)
  tenant           Tenant          @relation(fields: [tenantId], references: [tenantId])
  recepciones      RecepcionItem[]

  @@unique([tenantId, id])
  @@index([tenantId, ordenId])
  @@index([tenantId, productoId])
}

/// Recepción física de una OC; puede ser parcial y dejar backorder.
model Recepcion {
  id                String          @id @default(cuid())
  ordenId           String
  tenantId          String
  fecha             DateTime        @default(now())
  creadoPorId       String?
  claveIdempotencia String?
  orden       OrdenCompra     @relation(fields: [tenantId, ordenId], references: [tenantId, id], onDelete: Cascade)
  tenant      Tenant          @relation(fields: [tenantId], references: [tenantId])
  items       RecepcionItem[]

  @@unique([tenantId, claveIdempotencia])
  @@unique([tenantId, id])
  @@index([tenantId, ordenId])
}

/// Cantidad recibida para una línea concreta de la OC.
model RecepcionItem {
  id          String          @id @default(cuid())
  recepcionId String
  ordenItemId String
  productoId  String
  tenantId    String
  cantidad    Int
  recepcion   Recepcion       @relation(fields: [tenantId, recepcionId], references: [tenantId, id], onDelete: Cascade)
  ordenItem   OrdenCompraItem @relation(fields: [tenantId, ordenItemId], references: [tenantId, id], onDelete: Restrict)
  producto    Producto        @relation(fields: [tenantId, productoId], references: [tenantId, id], onDelete: Restrict)
  tenant      Tenant          @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId, recepcionId])
  @@index([tenantId, ordenItemId])
}

/// Regla min/max por producto y ubicación para sugerir compra o fabricación.
model ReglaReabastecimiento {
  id            String   @id @default(cuid())
  tenantId      String
  productoId    String
  tipoUbicacion String   @default("almacen")
  ubicacionId   String
  min           Int
  max           Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [tenantId])
  producto      Producto @relation(fields: [tenantId, productoId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, productoId, tipoUbicacion, ubicacionId])
  @@index([tenantId, ubicacionId])
}

/// Asignación FIFO: vincula unidades vendidas (VentaItem) con su compra de origen (CompraDocumentoItem).
/// Cada registro indica que `cantidad` unidades de la venta se asignaron al lote de compra
/// según la política FIFO (First In, First Out).
model PurchaseAllocation {
  id                    String              @id @default(cuid())
  tenantId              String
  compraDocumentoItemId String
  ventaItemId           String
  cantidad              Int
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  compraDocumentoItem   CompraDocumentoItem @relation(fields: [compraDocumentoItemId], references: [compraDocumentoItemId], onDelete: Cascade)
  tenant                Tenant              @relation(fields: [tenantId], references: [tenantId])
  ventaItem             VentaItem           @relation(fields: [ventaItemId], references: [id], onDelete: Cascade)

  @@index([compraDocumentoItemId])
  @@index([ventaItemId])
  @@index([tenantId])
  @@map("purchase_allocations")
}

model Servicios {
  servicioId      String           @id @default(cuid())
  tenantId        String
  nombre          String
  precio          Int
  descripcion     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  moneda          String           @default("CUP")
  compraServicios CompraServicio[]
  ofertaItems     OfertaItem[]
  tenant          Tenant           @relation(fields: [tenantId], references: [tenantId])
  ventasServicios VentaServicios[]

  @@index([tenantId])
}

model VentaServicios {
  ventaServicioId  String                   @id @default(cuid())
  tenantId         String
  servicioId       String
  cantidad         Int
  costo            Int                      @default(0)
  total            Int
  moneda           String                   @default("CUP")
  precioUnitario   Int?
  observaciones    String?
  reconciliado     Boolean?
  clienteId        String?
  ventaId          String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  reconciliaciones ReconciliacionServicio[]
  cliente          Cliente?                 @relation(fields: [clienteId], references: [clienteId], onDelete: Cascade)
  servicio         Servicios                @relation(fields: [servicioId], references: [servicioId], onDelete: Cascade)
  venta            Venta?                   @relation(fields: [ventaId], references: [ventaId], onDelete: SetNull)
  tenant           Tenant                   @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
  @@index([ventaId])
}

model CompraServicio {
  compraServicioId String    @id @default(cuid())
  tenantId         String
  servicioId       String
  proveedorId      String?
  numeroFactura    String?
  costoUnitario    Int
  cantidad         Int
  total            Int
  formaPago        String
  estado           String
  descripcion      String?
  fechaServicio    DateTime  @default(now())
  fechaVencimiento DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  moneda           String?
  proveedor        Vendor?   @relation(fields: [proveedorId], references: [vendorId])
  servicio         Servicios @relation(fields: [servicioId], references: [servicioId], onDelete: Cascade)
  tenant           Tenant    @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
  @@index([servicioId])
  @@index([proveedorId])
  @@index([estado])
}

model GastoConcepto {
  conceptoId  String          @id @default(cuid())
  tenantId    String
  nombre      String
  descripcion String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [tenantId])
  elementos   GastoElemento[]
  gastosDE    GastosDE[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

model GastoElemento {
  elementoId  String        @id @default(cuid())
  tenantId    String
  nombre      String
  descripcion String?
  isActive    Boolean       @default(true)
  conceptoId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [tenantId])
  concepto    GastoConcepto @relation(fields: [conceptoId], references: [conceptoId], onDelete: Cascade)
  gastosDE    GastosDE[]

  @@unique([tenantId, conceptoId, nombre])
  @@index([tenantId])
}

model GastosDE {
  gastosDEId       String                @id @default(cuid())
  tenantId         String
  tipo             String?
  conceptoId       String?
  elementoId       String?
  proveedor        String
  monto            Int
  periodo          String
  descripcion      String?
  isPagado         String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  numeroFactura    String?
  cuentaPorPagar   CuentaPorPagar?
  concepto         GastoConcepto?        @relation(fields: [conceptoId], references: [conceptoId])
  elemento         GastoElemento?        @relation(fields: [elementoId], references: [elementoId])
  tenant           Tenant                @relation(fields: [tenantId], references: [tenantId])
  reconciliaciones ReconciliacionGasto[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model Moneda {
  codigo                        String                         @id
  nombre                        String
  simbolo                       String
  esPrincipal                   Boolean                        @default(false)
  isActive                      Boolean                        @default(true)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  catalogoReparacionConfig      CatalogoReparacionConfig?
  tasasCambio                   TasaCambio[]
  transacciones                 TransaccionMoneda[]
  tenantAccountingPolicies      TenantAccountingPolicy[]
  financialAuxiliaryCheckpoints FinancialAuxiliaryCheckpoint[]
}

model TenantAccountingPolicy {
  tenantId               String   @id
  functionalCurrencyCode String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  updatedBy              String
  tenant                 Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  functionalCurrency     Moneda   @relation(fields: [functionalCurrencyCode], references: [codigo], onDelete: Restrict)

  @@index([functionalCurrencyCode])
  @@map("tenant_accounting_policies")
}

model AccountingPolicyRolloutRun {
  runId          String                         @id @default(cuid())
  mode           String
  manifestHash   String?
  status         String
  executorUserId String
  approverUserId String?
  reason         String
  summary        Json?
  createdAt      DateTime                       @default(now())
  completedAt    DateTime?
  entries        AccountingPolicyRolloutEntry[]

  @@index([mode, status, createdAt])
  @@index([manifestHash, mode, status])
  @@map("accounting_policy_rollout_runs")
}

model AccountingPolicyRolloutEntry {
  entryId                String                     @id @default(cuid())
  runId                  String
  tenantId               String
  functionalCurrencyCode String?
  expectedClassification String?
  observedClassification String
  projectedResult        String?
  finalResult            String?
  existingCurrencyCode   String?
  tenantApprovalId       String?
  safeError              String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  run                    AccountingPolicyRolloutRun @relation(fields: [runId], references: [runId], onDelete: Cascade)
  tenant                 Tenant                     @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)

  @@unique([runId, tenantId])
  @@index([tenantId, createdAt])
  @@map("accounting_policy_rollout_entries")
}

model AccountingPolicyTenantApproval {
  approvalId             String    @id @default(cuid())
  tenantId               String
  functionalCurrencyCode String
  actorUserId            String
  reason                 String
  status                 String    @default("ACTIVE")
  correlationId          String
  approvalHash           String
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime  @default(now())
  tenant                 Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)

  @@unique([tenantId, functionalCurrencyCode, approvalHash])
  @@index([tenantId, status, expiresAt])
  @@map("accounting_policy_tenant_approvals")
}

model FinancialAuxiliaryCheckpoint {
  checkpointId           String   @id @default(cuid())
  tenantId               String
  schemaVersion          Int?
  cutoffAt               DateTime
  capturedAt             DateTime
  functionalCurrencyCode String
  payload                Json
  hashIntegridad         String
  capturedBy             String
  createdAt              DateTime @default(now())
  tenant                 Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  functionalCurrency     Moneda   @relation(fields: [functionalCurrencyCode], references: [codigo], onDelete: Restrict)

  @@unique([tenantId, cutoffAt])
  @@index([tenantId, schemaVersion, cutoffAt])
  @@index([tenantId, capturedAt])
  @@index([functionalCurrencyCode])
  @@map("financial_auxiliary_checkpoints")
}

/// Evidencia histórica inmutable de una conversión FX aplicada a una partida.
model FxEvidence {
  fxEvidenceId        String   @id @default(cuid())
  tenantId            String
  sourceType          String
  sourceId            String
  originalAmount      Decimal  @db.Decimal(20, 8)
  originalCurrency    String
  functionalAmount    Decimal  @db.Decimal(20, 8)
  functionalCurrency  String
  exchangeRate        Decimal  @db.Decimal(20, 10)
  rateEffectiveAt     DateTime
  cutoffAt            DateTime
  fxCatalogRateId     String?
  provenance          String
  source              String
  evidence            Json
  evidenceFingerprint String
  evidenceVersion     Int
  capturedAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  tenant              Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)

  @@unique([tenantId, sourceType, sourceId, evidenceFingerprint])
  @@index([tenantId, sourceType, sourceId, cutoffAt])
  @@index([tenantId, sourceType, sourceId, capturedAt])
  @@map("fx_evidence")
}

model CatalogoReparacionConfig {
  id        Int      @id
  monedaId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  moneda    Moneda   @relation(fields: [monedaId], references: [codigo])
}

model TasaCambio {
  tasaId         String   @id @default(cuid())
  monedaOrigenId String
  monedaDestino  String
  tasa           Decimal
  fechaVigencia  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  monedaOrigen   Moneda   @relation(fields: [monedaOrigenId], references: [codigo])
}

model TransaccionMoneda {
  transaccionId   String   @id @default(cuid())
  tenantId        String?
  tipoTransaccion String
  referenciaId    String
  monedaId        String
  montoOriginal   Decimal
  tasaCambio      Decimal
  montoConvertido Decimal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  moneda          Moneda   @relation(fields: [monedaId], references: [codigo])

  @@index([tenantId])
  @@index([tipoTransaccion, referenciaId])
}

model CuentaBancaria {
  cuentaId                 String                   @id @default(cuid())
  tenantId                 String
  nombreBanco              String
  numeroCuenta             String
  tipoCuenta               String
  saldo                    Float                    @default(0)
  moneda                   String                   @default("CUP")
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  ajustes                  AjusteBancario[]
  tenant                   Tenant                   @relation(fields: [tenantId], references: [tenantId])
  inyeccionesCapital       InyeccionCapital[]
  miEmpresa                MiEmpresa?               @relation("MiEmpresaCuenta")
  pagosDeuda               PagoDeuda[]
  reconciliacionesGasto    ReconciliacionGasto[]
  reconciliacionesServicio ReconciliacionServicio[]
  reconciliacionesVenta    ReconciliacionVenta[]
  transferenciasDestino    TransferenciaBancaria[]  @relation("TransferenciasDestino")
  transferenciasOrigen     TransferenciaBancaria[]  @relation("TransferenciasOrigen")
  facturas                 Factura[]                @relation("FacturaCuenta")

  @@unique([tenantId, numeroCuenta])
  @@index([tenantId])
}

model TipoPago {
  tipoId                   String                   @id @default(cuid())
  tenantId                 String
  nombre                   String
  descripcion              String?
  requiereCuenta           Boolean                  @default(true)
  cuentaDefecto            String?
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  tenant                   Tenant                   @relation(fields: [tenantId], references: [tenantId])
  reconciliacionesGasto    ReconciliacionGasto[]
  reconciliacionesServicio ReconciliacionServicio[]
  reconciliacionesVenta    ReconciliacionVenta[]

  @@index([tenantId])
}

model ReconciliacionVenta {
  reconciliacionId            String         @id @default(cuid())
  tenantId                    String
  ventaId                     String?
  cuentaId                    String
  tipoPagoId                  String
  monto                       Decimal
  moneda                      String         @default("CUP")
  tasaCambio                  Decimal?
  montoConvertido             Decimal?
  functionalCurrency          String?
  rateEffectiveAt             DateTime?
  fxProvenanceKind            String?
  fxProvenanceSource          String?
  fxCatalogRateId             String?
  fxEvidenceJson              Json?
  fxEvidenceFingerprint       String?
  fxEvidenceVersion           Int?
  fechaReconciliacion         DateTime       @default(now())
  observaciones               String?
  reconciliadoPor             String
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  idTransferencia             String?
  verificacionTransferenciaId String?
  deudaCashId                 String?
  prestamoCashId              String?
  tipoReconciliacion          String?
  cuentaBancaria              CuentaBancaria @relation(fields: [cuentaId], references: [cuentaId])
  deudaCash                   DeudaCash?     @relation(fields: [deudaCashId], references: [id])
  prestamoCash                PrestamoCash?  @relation(fields: [prestamoCashId], references: [id])
  tenant                      Tenant         @relation(fields: [tenantId], references: [tenantId])
  tipoPago                    TipoPago       @relation(fields: [tipoPagoId], references: [tipoId])
  venta                       Venta?         @relation(fields: [ventaId], references: [ventaId])

  @@index([tenantId])
  @@index([tenantId, fxProvenanceKind])
  @@index([tenantId, fechaReconciliacion])
  @@index([tenantId, cuentaId, fechaReconciliacion])
}

model ReconciliacionServicio {
  reconciliacionId      String         @id @default(cuid())
  tenantId              String
  cuentaId              String
  tipoPagoId            String
  monto                 Decimal
  moneda                String         @default("CUP")
  tasaCambio            Decimal?
  montoConvertido       Decimal?
  functionalCurrency    String?
  rateEffectiveAt       DateTime?
  fxProvenanceKind      String?
  fxProvenanceSource    String?
  fxCatalogRateId       String?
  fxEvidenceJson        Json?
  fxEvidenceFingerprint String?
  fxEvidenceVersion     Int?
  fechaReconciliacion   DateTime       @default(now())
  observaciones         String?
  reconciliadoPor       String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  ventaServicioId       String
  cuentaBancaria        CuentaBancaria @relation(fields: [cuentaId], references: [cuentaId])
  tenant                Tenant         @relation(fields: [tenantId], references: [tenantId])
  tipoPago              TipoPago       @relation(fields: [tipoPagoId], references: [tipoId])
  ventasServicio        VentaServicios @relation(fields: [ventaServicioId], references: [ventaServicioId])

  @@index([tenantId])
  @@index([tenantId, fxProvenanceKind])
  @@index([tenantId, fechaReconciliacion])
  @@index([tenantId, cuentaId, fechaReconciliacion])
}

model ReconciliacionGasto {
  reconciliacionId      String          @id @default(cuid())
  tenantId              String
  tipoGasto             String
