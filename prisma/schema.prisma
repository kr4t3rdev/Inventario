// ── Períodos Contables ──────────────────────────────────────────────────

enum TipoPeriodo {
  DIARIO
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum EstadoPeriodo {
  BORRADOR
  ABIERTO
  EN_CIERRE
  CERRADO
  APROBADO
  REABIERTO
}

enum EventoAuditoria {
  APERTURA
  CIERRE
  REAPERTURA
  APROBACION
  BLOQUEO
  ERROR
  INTENTO_BYPASS
}

enum ModoContable {
  CAJA
  DEVENGO
}

enum CategoriaPeriodo {
  ORDINARIO
  EXTRAORDINARIO
  RECTIFICATIVO
}

model PeriodoContable {
  periodoId          String           @id @default(cuid())
  tenantId           String
  tipo               TipoPeriodo
  codigo             String? /// Código legible: "M-2026-03", "D-2026-03-15" — nullable para compatibilidad con datos existentes
  fechaInicio        DateTime
  fechaFin           DateTime
  estado             EstadoPeriodo    @default(BORRADOR)
  periodoPadreId     String? /// Jerarquía: DIARIO→MENSUAL→ANUAL
  aperturaAutomatica Boolean          @default(false)
  categoria          CategoriaPeriodo @default(ORDINARIO)
  modoContable       ModoContable     @default(CAJA)
  abiertoPorId       String?
  fechaApertura      DateTime?
  cerradoPor         String?
  cerradoAt          DateTime?
  aprobadoPor        String?
  aprobadoAt         DateTime?
  reabiertoPorId     String?
  fechaReapertura    DateTime?
  segundoAprobadorId String? /// Segunda aprobación multinivel
  motivoReapertura   String?
  observaciones      String?
  resumenJson        Json? /// Resumen de saldos agregados al cierre
  hashIntegridad     String? /// SHA256 del resumenJson
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [tenantId])
  snapshots        SaldoSnapshot[]
  snapshotPeriodos SnapshotPeriodo[]
  auditoria        AuditoriaPeriodo[]
  periodoPadre     PeriodoContable?   @relation("PeriodoHierarchy", fields: [periodoPadreId], references: [periodoId], onDelete: SetNull)
  subperiodos      PeriodoContable[]  @relation("PeriodoHierarchy")
  apertura         AperturaPeriodo?

  @@unique([tenantId, codigo])
  @@index([tenantId, estado])
  @@index([tenantId, periodoPadreId])
  @@map("periodos_contables")
}

model SnapshotPeriodo {
  snapshotId      String   @id @default(cuid())
  periodoId       String
  version         Int      @default(1)
  baseCajaJson    Json? /// Datos crudos del snapshot en base caja
  baseDevengoJson Json? /// Datos crudos del snapshot en base devengo
  resumenJson     Json? /// Resumen agregado (mismo que PeriodoContable.resumenJson)
  hashIntegridad  String? /// SHA256 del resumenJson
  createdAt       DateTime @default(now())

  periodo PeriodoContable @relation(fields: [periodoId], references: [periodoId], onDelete: Cascade)

  @@unique([periodoId, version])
  @@index([periodoId, createdAt])
  @@map("snapshot_periodos")
}

model AperturaPeriodo {
  aperturaId                String   @id @default(cuid())
  periodoId                 String   @unique
  tenantId                  String
  origenPeriodoId           String?
  saldoCajaInicial          Decimal  @default(0)
  saldoBancoInicial         Decimal  @default(0)
  saldoCuentasCobrarInicial Decimal  @default(0)
  saldoCuentasPagarInicial  Decimal  @default(0)
  saldoInventarioInicial    Decimal  @default(0)
  saldoCapitalInicial       Decimal  @default(0)
  saldoResultadoAcumInicial Decimal  @default(0)
  detalleJson               Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  periodo PeriodoContable @relation(fields: [periodoId], references: [periodoId], onDelete: Cascade)
  tenant  Tenant          @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
  @@index([origenPeriodoId])
  @@map("apertura_periodos")
}

model SaldoSnapshot {
  snapshotId       String   @id @default(cuid())
  periodoId        String
  cuentaBancariaId String
  saldo            Float
  moneda           String
  metadata         Json?
  createdAt        DateTime @default(now())

  periodo PeriodoContable @relation(fields: [periodoId], references: [periodoId], onDelete: Cascade)

  @@index([periodoId])
  @@index([cuentaBancariaId])
  @@map("saldos_snapshot")
}

model AuditoriaPeriodo {
  auditoriaId     String          @id @default(cuid())
  tenantId        String
  periodoId       String
  evento          EventoAuditoria
  actor           String
  timestamp       DateTime        @default(now())
  entidadAfectada String?
  motivo          String?
  payload         Json?
  createdAt       DateTime        @default(now())

  periodo PeriodoContable @relation(fields: [periodoId], references: [periodoId], onDelete: Cascade)
  tenant  Tenant          @relation(fields: [tenantId], references: [tenantId])

  @@index([periodoId])
  @@index([tenantId, timestamp])
  @@index([evento])
  @@map("auditoria_periodos")
}

// ── Backups ─────────────────────────────────────────────────────────────────

enum BackupType {
  full
  tenant
  config
}

enum BackupStatus {
  running
  completed
  failed
  pruned
  deleted
}

enum EstadoTurno {
  ABIERTO
  CERRADO
}

enum MetodoPagoVenta {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CREDITO
  MIXTO
}

/// Registro de cada operación de backup o restore.
model BackupLog {
  backupLogId  String       @id @default(cuid())
  type         BackupType
  tenantId     String?
  status       BackupStatus
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  errorMessage String?
  createdBy    String
  createdAt    DateTime     @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [tenantId])
  user   User    @relation(fields: [createdBy], references: [userId])

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("backup_logs")
}

/// Plan de backup programado.
model BackupPlan {
  backupPlanId String     @id @default(cuid())
  type         BackupType
  tenantId     String?
  schedule     String
  enabled      Boolean    @default(true)
  retention    Int        @default(30)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdBy    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [tenantId])
  user   User    @relation(fields: [createdBy], references: [userId])

  @@index([enabled, nextRunAt])
  @@index([tenantId])
  @@map("backup_plans")
}

/// Caché compartido de períodos contables activos (PostgreSQL-backed).
/// Reemplaza el Map en memoria para que múltiples instancias compartan
/// el mismo caché. Cada entrada tiene TTL definido por expiresAt.
model PeriodoCache {
  cacheKey      String   @id
  tenantId      String
  fecha         DateTime
  resultadoJson Json
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([tenantId, expiresAt])
  @@index([expiresAt])
  @@map("periodo_cache")
}
