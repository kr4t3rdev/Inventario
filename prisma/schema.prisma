  updatedAt                DateTime          @updatedAt
  referrerTenant           Tenant            @relation("ReferrerAffiliateCommissionEntries", fields: [referrerTenantId], references: [tenantId], onDelete: Cascade)
  referral                 AffiliateReferral @relation(fields: [referralId], references: [referralId], onDelete: Cascade)
  sourceTenantLicense      TenantLicense     @relation("AffiliateSourceLicense", fields: [sourceTenantLicenseId], references: [tenantLicenseId], onDelete: Cascade)
  appliedToTenantLicense   TenantLicense?    @relation("AffiliateAppliedLicense", fields: [appliedToTenantLicenseId], references: [tenantLicenseId], onDelete: SetNull)

  @@index([referrerTenantId, status])
  @@index([referralId])
}

model AffiliateCreditBalance {
