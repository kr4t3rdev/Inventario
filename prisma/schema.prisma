}

model DefectacionCatalogo {
  id        String                @id @default(cuid())
  tenantId  String
  defecto   String
  costo     Int
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  tenant    Tenant                @relation(fields: [tenantId], references: [tenantId])
  items     OrdenReparacionItem[]

  @@index([tenantId])
}

model ConfiguracionSistema {
  configId                     String   @id @default(cuid())
  diasAvisoVencimientoContrato Int      @default(30)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model OrdenProduccion {
  ordenProduccionId        String                     @id
  tenantId                 String
  recetaId                 String
  cantidad                 Int
  estado                   EstadoProduccion           @default(PENDIENTE)
  observaciones            String?                    @db.VarChar(1000)
  fechaProduccion          DateTime                   @default(now())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  costoMateriales          Float?
  Receta                   Receta                     @relation(fields: [recetaId], references: [recetaId], onDelete: Cascade)
  tenant                   Tenant                     @relation(fields: [tenantId], references: [tenantId])
  OrdenProduccionHistorial OrdenProduccionHistorial[]

  @@index([tenantId])
}

model OrdenProduccionHistorial {
  ordenProduccionId String
  tenantId          String
  estadoAnterior    String
  estadoNuevo       String
  observaciones     String?
  usuarioId         String?
  createdAt         DateTime        @default(now())
  id                String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  OrdenProduccion   OrdenProduccion @relation(fields: [ordenProduccionId], references: [ordenProduccionId], onDelete: Cascade)
  tenant            Tenant          @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
}

model Receta {
  recetaId          String              @id
  tenantId          String
  nombre            String              @db.VarChar(160)
  rendimiento       Int                 @default(1)
  costoUnitario     Float               @default(0)
  instrucciones     String?             @db.VarChar(4000)
  tiempoPrep        Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  productoId        String?
  OrdenProduccion   OrdenProduccion[]
  Producto          Producto?           @relation(fields: [productoId], references: [id])
  tenant            Tenant              @relation(fields: [tenantId], references: [tenantId])
  RecetaIngrediente RecetaIngrediente[]

  @@index([tenantId])
}

model RecetaIngrediente {
  recetaId      String
  tenantId      String
  productoId    String
  cantidad      Float
  desperdicio   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  id            String   @id
  unidadSimbolo String?
  Producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  Receta        Receta   @relation(fields: [recetaId], references: [recetaId], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
}

model ValeSalida {
  valeSalidaId   String           @id
  tenantId       String
  concepto       String           @db.VarChar(200)
  observaciones  String?          @db.VarChar(1000)
  estado         String           @default("COMPLETADO")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  tenant         Tenant           @relation(fields: [tenantId], references: [tenantId])
  ValeSalidaItem ValeSalidaItem[]

  @@index([tenantId])
}

model ValeSalidaItem {
  valeSalidaItemId String     @id
  tenantId         String
  valeSalidaId     String
  productoId       String
  cantidad         Int
  createdAt        DateTime   @default(now())
  Producto         Producto   @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tenant           Tenant     @relation(fields: [tenantId], references: [tenantId])
  ValeSalida       ValeSalida @relation(fields: [valeSalidaId], references: [valeSalidaId], onDelete: Cascade)

  @@index([tenantId])
}

model ListaPrecio {
  id            String           @id @default(cuid())
  tenantId      String
  nombre        String
  descripcion   String?
  esDefault     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenant        Tenant           @relation(fields: [tenantId], references: [tenantId])
  precios       PrecioProducto[]
  puntosDeVenta PuntoDeVenta[]
  clientes      Cliente[]

  @@index([tenantId])
}

model PrecioProducto {
  id            String      @id @default(cuid())
  listaPrecioId String
  productoId    String
  precio        Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  listaPrecio   ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  producto      Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([listaPrecioId, productoId])
}

model ProductoCostHistory {
  id             String           @id @default(cuid())
  productoId     String
  oldPrecioCosto Int
  newPrecioCosto Int
  oldPrecioVenta Int
  newPrecioVenta Int
  reason         CostChangeReason
  changedBy      String
  changedAt      DateTime
  notes          String?
  createdAt      DateTime         @default(now())
  producto       Producto         @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
  @@index([changedAt])
  @@index([reason])
}

/// * Plantilla de ficha de costo versionada por producto.
/// Cada producto puede tener N versiones, pero solo una activa.
/// Los valores de costo se almacenan en Float para soportar
/// decimales en materiales, MO e indirectos.
model ProductoCostSheetTemplate {
  id              String   @id @default(cuid())
  tenantId        String
  productoId      String
  version         Int      @default(1)
  nombre          String   @default("")
  costoMateriales Float    @default(0)
  costoManoObra   Float    @default(0)
  costoIndirectos Float    @default(0)
  margenObjetivo  Float    @default(0.30)
  precioSugerido  Float    @default(0)
  esActiva        Boolean  @default(false)
  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String
  lineItems       Json     @default("[]")

  @@unique([productoId, version])
  @@index([tenantId])
  @@index([productoId])
}

model VendorCodeSequence {
  id         Int @id @default(1)
  nextNumber Int @default(1)
}

model Anticipo {
  anticipoId        String               @id @default(cuid())
  tenantId          String
  tipo              TipoAnticipo
  estado            EstadoAnticipo       @default(RESERVADO)
  contratoId        String
  proveedorId       String?
  clienteId         String?
  facturaId         String?              @unique
  compraProductoId  String?              @unique
  montoOriginal     Decimal
  saldoDisponible   Decimal
  moneda            String               @default("CUP")
  cuentaOrigenId    String?
  tipoPagoOrigenId  String?
  referenciaExterna String?
  vigenciaHasta     DateTime?
  fechaReserva      DateTime             @default(now())
  fechaEjecucion    DateTime?
  createdById       String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  cliente           Cliente?             @relation(fields: [clienteId], references: [clienteId])
  compraProducto    CompraProducto?      @relation(fields: [compraProductoId], references: [compraProductoId])
  contrato          Contrato             @relation(fields: [contratoId], references: [contratoId])
  creador           User                 @relation(fields: [createdById], references: [userId])
  factura           Factura?             @relation(fields: [facturaId], references: [idFactura])
  proveedor         Vendor?              @relation(fields: [proveedorId], references: [vendorId])
  tenant            Tenant               @relation(fields: [tenantId], references: [tenantId])
  movimientos       AnticipoMovimiento[]

  @@index([tenantId])
  @@index([contratoId])
  @@index([proveedorId])
  @@index([clienteId])
  @@index([facturaId])
  @@index([compraProductoId])
  @@index([estado])
  @@index([tipo])
}

model AnticipoMovimiento {
  movimientoId          String            @id @default(cuid())
  anticipoId            String
  tipoMovimiento        String
  contexto              ContextoAnticipo?
  documentoDestinoId    String?
  reconciliacionVentaId String?
  reconciliacionGastoId String?
  monto                 Decimal
  moneda                String
  tasaAplicada          Decimal?
  montoConvertido       Decimal?
  saldoAntes            Decimal
  saldoDespues          Decimal
  usuarioId             String
  idempotencyKey        String?
  observaciones         String?
  createdAt             DateTime          @default(now())
  anticipo              Anticipo          @relation(fields: [anticipoId], references: [anticipoId], onDelete: Cascade)

  @@unique([anticipoId, idempotencyKey])
  @@index([anticipoId, createdAt])
  @@index([documentoDestinoId])
}

model PeriodoContable {
  periodoId          String             @id @default(cuid())
  tenantId           String
  tipo               TipoPeriodo
  fechaInicio        DateTime
  fechaFin           DateTime
  estado             EstadoPeriodo      @default(BORRADOR)
  motivoReapertura   String?
  cerradoPor         String?
  cerradoAt          DateTime?
  aprobadoPor        String?
  aprobadoAt         DateTime?
  observaciones      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  /// SHA256 del resumenJson
  hashIntegridad     String?
  /// Resumen de saldos agregados al cierre
  resumenJson        Json?
  abiertoPorId       String?
  aperturaAutomatica Boolean            @default(false)
  /// Código legible: "M-2026-03", "D-2026-03-15" — nullable para compatibilidad con datos existentes
  codigo             String?
  fechaApertura      DateTime?
  fechaReapertura    DateTime?
  /// Jerarquía: DIARIO→MENSUAL→ANUAL
  periodoPadreId     String?
  reabiertoPorId     String?
  /// Segunda aprobación multinivel
  segundoAprobadorId String?
  categoria          CategoriaPeriodo   @default(ORDINARIO)
  modoContable       ModoContable       @default(CAJA)
  apertura           AperturaPeriodo?
  auditoria          AuditoriaPeriodo[]
  periodoPadre       PeriodoContable?   @relation("PeriodoHierarchy", fields: [periodoPadreId], references: [periodoId])
  subperiodos        PeriodoContable[]  @relation("PeriodoHierarchy")
  tenant             Tenant             @relation(fields: [tenantId], references: [tenantId])
  snapshots          SaldoSnapshot[]
  snapshotPeriodos   SnapshotPeriodo[]

  @@unique([tenantId, codigo])
  @@index([tenantId, estado])
  @@index([tenantId, periodoPadreId])
  @@map("periodos_contables")
}

model SnapshotPeriodo {
  snapshotId               String          @id @default(cuid())
  periodoId                String
  version                  Int             @default(1)
  /// Nullable para conservar filas v2 existentes sin reinterpretarlas como v3.
  tenantId                 String?
  schemaVersion            Int?
  status                   String?
  cutoffAt                 DateTime?
  capturedAt               DateTime?
  approvedAt               DateTime?
  approvedBy               String?
  canonicalContractVersion String?
  /// Datos crudos del snapshot en base caja
  baseCajaJson             Json?
  /// Datos crudos del snapshot en base devengo
  baseDevengoJson          Json?
  /// Resumen agregado (mismo que PeriodoContable.resumenJson)
  resumenJson              Json?
  /// SHA256 del resumenJson
  hashIntegridad           String?
  createdAt                DateTime        @default(now())
  periodo                  PeriodoContable @relation(fields: [periodoId], references: [periodoId], onDelete: Cascade)
  tenant                   Tenant?         @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)

  @@unique([periodoId, version])
  @@index([tenantId, status, cutoffAt])
  @@index([periodoId, createdAt])
  @@map("snapshot_periodos")
}

model AperturaPeriodo {
  aperturaId                String          @id @default(cuid())
  periodoId                 String          @unique
  tenantId                  String
  origenPeriodoId           String?
  saldoCajaInicial          Decimal         @default(0)
  saldoBancoInicial         Decimal         @default(0)
  saldoCuentasCobrarInicial Decimal         @default(0)
  saldoCuentasPagarInicial  Decimal         @default(0)
  saldoInventarioInicial    Decimal         @default(0)
  saldoCapitalInicial       Decimal         @default(0)
  saldoResultadoAcumInicial Decimal         @default(0)
  detalleJson               Json?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  periodo                   PeriodoContable @relation(fields: [periodoId], references: [periodoId], onDelete: Cascade)
  tenant                    Tenant          @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
  @@index([origenPeriodoId])
  @@map("apertura_periodos")
}

model SaldoSnapshot {
  snapshotId       String          @id @default(cuid())
  tenantId         String?
  periodoId        String
  cuentaBancariaId String
  saldo            Float
  moneda           String
  metadata         Json?
  createdAt        DateTime        @default(now())
  periodo          PeriodoContable @relation(fields: [periodoId], references: [periodoId], onDelete: Cascade)

  @@index([periodoId])
  @@index([cuentaBancariaId])
  @@index([tenantId])
  @@map("saldos_snapshot")
}

model AuditoriaPeriodo {
  auditoriaId     String          @id @default(cuid())
  tenantId        String
  periodoId       String
  evento          EventoAuditoria
  actor           String
  timestamp       DateTime        @default(now())
  entidadAfectada String?
  motivo          String?
  payload         Json?
  createdAt       DateTime        @default(now())
  periodo         PeriodoContable @relation(fields: [periodoId], references: [periodoId], onDelete: Cascade)
  tenant          Tenant          @relation(fields: [tenantId], references: [tenantId])

  @@index([periodoId])
  @@index([tenantId, timestamp])
  @@index([evento])
  @@map("auditoria_periodos")
}

/// Registro de cada operación de backup o restore.
model BackupLog {
  backupLogId  String       @id @default(cuid())
  type         BackupType
  tenantId     String?
  status       BackupStatus
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  errorMessage String?
  createdBy    String
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [createdBy], references: [userId])
  tenant       Tenant?      @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("backup_logs")
}

/// Plan de backup programado.
model BackupPlan {
  backupPlanId String     @id @default(cuid())
  type         BackupType
  tenantId     String?
  schedule     String
  enabled      Boolean    @default(true)
  retention    Int        @default(30)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdBy    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [createdBy], references: [userId])
  tenant       Tenant?    @relation(fields: [tenantId], references: [tenantId])

  @@index([enabled, nextRunAt])
  @@index([tenantId])
  @@map("backup_plans")
}

/// Caché compartido de períodos contables activos (PostgreSQL-backed).
/// Reemplaza el Map en memoria para que múltiples instancias compartan
/// el mismo caché. Cada entrada tiene TTL definido por expiresAt.
model PeriodoCache {
  cacheKey      String   @id
  tenantId      String
  fecha         DateTime
  resultadoJson Json
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([tenantId, expiresAt])
  @@index([expiresAt])
  @@map("periodo_cache")
}

/// Reseña de un usuario sobre el sistema.
model Review {
  reviewId   String   @id @default(cuid())
  tenantId   String
  userId     String
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  isPositive Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, isApproved])
  @@index([tenantId, isPositive, isApproved])
  @@map("reviews")
}

/// Traza de solicitudes de reseña.
model ReviewPrompt {
  promptId    String    @id @default(cuid())
  tenantId    String
  userId      String
  promptedAt  DateTime  @default(now())
  dismissedAt DateTime?
  submittedAt DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([tenantId, userId, promptedAt])
  @@map("review_prompts")
}

