generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  catId                 String      @id @default(cuid())
  nombre                String
  descripcion           String?
  parentId              String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  parent                Categoria?  @relation("CategoriaHierarchy", fields: [parentId], references: [catId], onDelete: Cascade)
  subcategorias         Categoria[] @relation("CategoriaHierarchy")
  productos             Producto[]
  productosSubcategoria Producto[]  @relation("ProductoSubcategoria")
}

model Unidad {
  unidadId  String     @id @default(cuid())
  nombre    String
  simbolo   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  productos Producto[]
}

model Vendor {
  vendorId     String        @id @default(cuid())
  nombre       String
  contacto     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  Documento    Documento[]
  gastoCompras GastoCompra[]
  productos    Producto[]
}

model InyeccionCapital {
  id                 String         @id @default(cuid())
  tipo               TipoInyeccion
  montoRecibido      Decimal
  moneda             String         @default("CUP")
  tasaInteres        Decimal?
  montoInteres       Decimal?
  montoTotalDeuda    Decimal?
  saldoPendiente     Decimal?
  plazoMeses         Int?
  fechaInicioPago    DateTime?
  socio              String?
  entidadPrestamista String?
  cuentaId           String
  estado             EstadoDeuda?   @default(ACTIVA)
  descripcion        String?
  fechaRegistro      DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  cuentaBancaria     CuentaBancaria @relation(fields: [cuentaId], references: [cuentaId])
  pagos              PagoDeuda[]
}

model PagoDeuda {
  id             String           @id @default(cuid())
  inyeccionId    String
  montoPagado    Decimal
  fechaPago      DateTime         @default(now())
  cuentaId       String
  numeroCuota    Int?
  comprobante    String?
  observaciones  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cuentaBancaria CuentaBancaria   @relation(fields: [cuentaId], references: [cuentaId])
  inyeccion      InyeccionCapital @relation(fields: [inyeccionId], references: [id], onDelete: Cascade)
}

model Cliente {
  clienteId       String           @id @default(cuid())
  nombre          String
  cargo           String
  empresa         String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  Documento       Documento[]
  Venta           Venta[]
  ventasServicios VentaServicios[]
}

model Almacen {
  almacenId             String          @id @default(cuid())
  nombre                String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  productos             Producto[]
  transferenciasDestino Transferencia[] @relation("TransferenciasDestino")
  transferenciasOrigen  Transferencia[] @relation("TransferenciasOrigen")
}

model PuntoDeVenta {
  pvId                  String          @id @default(cuid())
  nombre                String
  ubicacion             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  productos             Producto[]
  transferenciasDestino Transferencia[] @relation("TransferenciasDestino")
  transferenciasOrigen  Transferencia[] @relation("TransferenciasOrigen")
  ventas                Venta[]
}

model Producto {
  id             String          @id @default(cuid())
  nombre         String
  descripcion    String?
  precioCosto    Int
  precioVenta    Int
  stock          Int
  stockMinimo    Int             @default(0)
  categoriaId    String
  subcategoriaId String?
  unidadId       String?
  vendorId       String
  almacenId      String
  puntoDeVentaId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  gastoCompras   GastoCompra[]
  mermas         Merma[]
  almacen        Almacen         @relation(fields: [almacenId], references: [almacenId], onDelete: Cascade)
  categoria      Categoria       @relation(fields: [categoriaId], references: [catId], onDelete: Cascade)
  puntoDeVenta   PuntoDeVenta?   @relation(fields: [puntoDeVentaId], references: [pvId], onDelete: Cascade)
  subcategoria   Categoria?      @relation("ProductoSubcategoria", fields: [subcategoriaId], references: [catId])
  unidad         Unidad?         @relation(fields: [unidadId], references: [unidadId], onDelete: Cascade)
  vendor         Vendor          @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  transferencias Transferencia[]
  ventas         Venta[]
}

model Venta {
  ventaId          String                @id @default(cuid())
  productoId       String?
  cantidad         Int
  total            Int?
  descuento        Int?
  observaciones    String?
  puntoDeVentaId   String
  empleadoId       String?
  clienteId        String?
  ordenId          String?
  esVentaUnica     Boolean               @default(false)
  ventaPadreId     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  Documento        Documento[]
  reconciliaciones ReconciliacionVenta[]
  cliente          Cliente?              @relation(fields: [clienteId], references: [clienteId], onDelete: Cascade)
  empleado         Empleado?             @relation(fields: [empleadoId], references: [empleadoId])
  producto         Producto?             @relation(fields: [productoId], references: [id], onDelete: Cascade)
  puntoDeVenta     PuntoDeVenta          @relation(fields: [puntoDeVentaId], references: [pvId])
}

model Merma {
  mermaId    String   @id @default(cuid())
  productoId String
  cantidad   Int
  motivo     String?
  costoTotal Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Transferencia {
  transferenciaId       String        @id @default(cuid())
  productoId            String
  cantidad              Int
  descripcion           String?
  origenId              String?
  destinoId             String?
  puntoDeVentaOrigenId  String?
  puntoDeVentaDestinoId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  destino               Almacen?      @relation("TransferenciasDestino", fields: [destinoId], references: [almacenId])
  origen                Almacen?      @relation("TransferenciasOrigen", fields: [origenId], references: [almacenId])
  producto              Producto      @relation(fields: [productoId], references: [id], onDelete: Cascade)
  puntoDeVentaDestino   PuntoDeVenta? @relation("TransferenciasDestino", fields: [puntoDeVentaDestinoId], references: [pvId])
  puntoDeVentaOrigen    PuntoDeVenta? @relation("TransferenciasOrigen", fields: [puntoDeVentaOrigenId], references: [pvId])
}

model User {
  userId                                              String               @id @default(cuid())
  name                                                String
  email                                               String               @unique
  password                                            String
  role                                                String               @default("regularUser")
  onboardingType                                      String?
  onboardingStatus                                    String               @default("pending_email_verification")
  emailVerifiedAt                                     DateTime?
  isActive                                            Boolean              @default(true)
  avatar                                              String?
  activatedAt                                         DateTime?
  expiresAt                                           DateTime?
  createdAt                                           DateTime             @default(now())
  updatedAt                                           DateTime             @updatedAt
  lastModifiedBy                                      String?
  loginAttempts                                       Int                  @default(0)
  lockedUntil                                         DateTime?
  lastFailedLogin                                     DateTime?
  Documento_Documento_actualizadoPorIdToUser          Documento[]          @relation("Documento_actualizadoPorIdToUser")
  Documento_Documento_creadoPorIdToUser               Documento[]          @relation("Documento_creadoPorIdToUser")
  DocumentoAcceso_DocumentoAcceso_otorgadoPorIdToUser DocumentoAcceso[]    @relation("DocumentoAcceso_otorgadoPorIdToUser")
  DocumentoAcceso_DocumentoAcceso_usuarioIdToUser     DocumentoAcceso[]    @relation("DocumentoAcceso_usuarioIdToUser")
  DocumentoAuditoria                                  DocumentoAuditoria[]
  DocumentoFirma                                      DocumentoFirma[]
  DocumentoVersion                                    DocumentoVersion[]
  notifications                                       Notification[]
  PlantillaDocumento                                  PlantillaDocumento[]
  activityLogs                                        UserActivityLog[]
  sessions                                            UserSession[]
  tenantMemberships                                   TenantMembership[]
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  userId    String
  prioridad String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model UserActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  details     String?
  ipAddress   String?
  userAgent   String?
  performedBy String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  ipAddress  String?
  userAgent  String?
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastActive DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model Attendance {
  attendanceId   String    @id @default(cuid())
  employeeId     String
  date           DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  totalHours     Decimal?  @db.Decimal(5, 2)
  status         String    @default("present")
  manualCheckIn  DateTime?
  manualCheckOut DateTime?
  isManualEntry  Boolean   @default(false)
  notes          String?
  scheduledHours Decimal?  @db.Decimal(4, 2)
  overtimeHours  Decimal?  @db.Decimal(4, 2)
  breakHours     Decimal?  @db.Decimal(3, 2)
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       Empleado  @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)
}

model EmployeeWorkSchedule {
  scheduleId     String   @id @default(cuid())
  employeeId     String
  dayOfWeek      Int
  startTime      String
  endTime        String
  breakStartTime String?
  breakEndTime   String?
  isWorkingDay   Boolean  @default(true)
  scheduledHours Decimal  @db.Decimal(4, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Empleado @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
}

model VacationRequest {
  requestId     String    @id @default(cuid())
  employeeId    String
  startDate     DateTime
  endDate       DateTime
  daysRequested Int
  reason        String?
  status        String    @default("pending")
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Empleado  @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)
}

/// *
/// * Modelo para registro de acumulación automática de vacaciones
model VacationAccrual {
  accrualId              String   @id @default(cuid())
  employeeId             String
  periodo                String
  diasAcumulados         Int
  diasPorAntiguedad      Int
  diasPorTiempoTrabajado Int
  tipoAcumulacion        String
  fechaCalculo           DateTime @default(now())
  procesado              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  employee               Empleado @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)
}

model Empleado {
  empleadoId            String                 @id @default(cuid())
  nombre                String
  apellido              String
  telefono              String?
  cargo                 String
  salarioBases          Int
  vacationDaysAccrued   Int                    @default(0)
  vacationDaysUsed      Int                    @default(0)
  fechaContratacion     DateTime
  esTiempoCompleto      Boolean                @default(true)
  diasVacacionesAnuales Int                    @default(15)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  attendances           Attendance[]
  Documento             Documento[]
  workSchedules         EmployeeWorkSchedule[]
  PagoSalario           Pagosalario[]
  vacationAccruals      VacationAccrual[]
  vacationRequests      VacationRequest[]
  ventas                Venta[]
}

model Pagosalario {
  pgId                String                @id @default(cuid())
  empleadoId          String
  salario             Int
  bonificaciones      Int?                  @default(0)
  deducciones         Int?                  @default(0)
  horasExtras         Int?                  @default(0)
  observaciones       String?
  periodo             String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  empleado            Empleado              @relation(fields: [empleadoId], references: [empleadoId], onDelete: Cascade)
  ReconciliacionGasto ReconciliacionGasto[]
}

model CierreContable {
  cierreId            String   @id @default(cuid())
  tipo                String
  fechaInicio         DateTime
  fechaFin            DateTime
  totalVentas         Decimal  @default(0)
  totalGastos         Decimal  @default(0)
  ganancias           Decimal  @default(0)
  perdidas            Decimal  @default(0)
  ingresosCaja        Decimal  @default(0)
  egresosCaja         Decimal  @default(0)
  deudasClientes      Decimal  @default(0)
  deudasProveedores   Decimal  @default(0)
  inventarioVendido   Int      @default(0)
  inventarioRebajado  Int      @default(0)
  stockFinal          Int      @default(0)
  margenGanancia      Decimal  @default(0)
  margenPerdida       Decimal  @default(0)
  ventasVsExistencias String?
  estado              String   @default("abierto")
  creadoPor           String
  aprobadoPor         String?
  observaciones       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model GastoCompra {
  gastoCompraId    String                @id @default(cuid())
  productoId       String
  vendorId         String
  cantidad         Int
  precioUnitario   Int
  total            Int
  fechaCompra      DateTime              @default(now())
  descripcion      String?
  periodo          String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  producto         Producto              @relation(fields: [productoId], references: [id], onDelete: Cascade)
  vendor           Vendor                @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  reconciliaciones ReconciliacionGasto[]
}

model Servicios {
  servicioId      String           @id @default(cuid())
  nombre          String
  precio          Int
  descripcion     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ventasServicios VentaServicios[]
}

model VentaServicios {
  ventaServicioId  String                   @id @default(cuid())
  servicioId       String
  cantidad         Int
  total            Int
  observaciones    String?
  reconciliado     Boolean?
  clienteId        String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  reconciliaciones ReconciliacionServicio[]
  cliente          Cliente?                 @relation(fields: [clienteId], references: [clienteId], onDelete: Cascade)
  servicio         Servicios                @relation(fields: [servicioId], references: [servicioId], onDelete: Cascade)
}

model GastosDE {
  gastosDEId       String                @id @default(cuid())
  tipo             String
  proveedor        String
  monto            Int
  periodo          String
  descripcion      String?
  isPagado         String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  reconciliaciones ReconciliacionGasto[]
}

model Moneda {
  codigo        String              @id
  nombre        String
  simbolo       String
  esPrincipal   Boolean             @default(false)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tasasCambio   TasaCambio[]
  transacciones TransaccionMoneda[]
}

model TasaCambio {
  tasaId         String   @id @default(cuid())
  monedaOrigenId String
  monedaDestino  String
  tasa           Decimal
  fechaVigencia  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  monedaOrigen   Moneda   @relation(fields: [monedaOrigenId], references: [codigo])
}

model TransaccionMoneda {
  transaccionId   String   @id @default(cuid())
  tipoTransaccion String
  referenciaId    String
  monedaId        String
  montoOriginal   Decimal
  tasaCambio      Decimal
  montoConvertido Decimal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  moneda          Moneda   @relation(fields: [monedaId], references: [codigo])
}

model CuentaBancaria {
  cuentaId                 String                   @id @default(cuid())
  nombreBanco              String
  numeroCuenta             String                   @unique
  tipoCuenta               String
  saldo                    Float                    @default(0)
  moneda                   String                   @default("CUP")
  isActive                 Boolean
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  ajustes                  AjusteBancario[]
  inyeccionesCapital       InyeccionCapital[]
  pagosDeuda               PagoDeuda[]
  reconciliacionesGasto    ReconciliacionGasto[]
  reconciliacionesServicio ReconciliacionServicio[]
  reconciliacionesVenta    ReconciliacionVenta[]
  transferenciasDestino    TransferenciaBancaria[]  @relation("TransferenciasDestino")
  transferenciasOrigen     TransferenciaBancaria[]  @relation("TransferenciasOrigen")
}

model TipoPago {
  tipoId                   String                   @id @default(cuid())
  nombre                   String
  descripcion              String?
  requiereCuenta           Boolean                  @default(true)
  cuentaDefecto            String?
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  reconciliacionesGasto    ReconciliacionGasto[]
  reconciliacionesServicio ReconciliacionServicio[]
  reconciliacionesVenta    ReconciliacionVenta[]
}

model ReconciliacionVenta {
  reconciliacionId    String         @id @default(cuid())
  ventaId             String
  cuentaId            String
  tipoPagoId          String
  monto               Decimal
  moneda              String         @default("CUP")
  tasaCambio          Decimal?
  montoConvertido     Decimal?
  fechaReconciliacion DateTime       @default(now())
  observaciones       String?
  reconciliadoPor     String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  cuentaBancaria      CuentaBancaria @relation(fields: [cuentaId], references: [cuentaId])
  tipoPago            TipoPago       @relation(fields: [tipoPagoId], references: [tipoId])
  venta               Venta          @relation(fields: [ventaId], references: [ventaId])
}

model ReconciliacionServicio {
  reconciliacionId    String         @id @default(cuid())
  ventaServicioId     String
  cuentaId            String
  tipoPagoId          String
  monto               Decimal
  moneda              String         @default("CUP")
  tasaCambio          Decimal?
  montoConvertido     Decimal?
  fechaReconciliacion DateTime       @default(now())
  observaciones       String?
  reconciliadoPor     String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  cuentaBancaria      CuentaBancaria @relation(fields: [cuentaId], references: [cuentaId])
  tipoPago            TipoPago       @relation(fields: [tipoPagoId], references: [tipoId])
  ventasServicio      VentaServicios @relation(fields: [ventaServicioId], references: [ventaServicioId])
}

model ReconciliacionGasto {
  reconciliacionId    String         @id @default(cuid())
  tipoGasto           String
  referenciaId        String
  cuentaId            String
  tipoPagoId          String
  pgId                String?
  gastosDEId          String?
  gastoCompraId       String?
  monto               Decimal
  moneda              String         @default("CUP")
  tasaCambio          Decimal?
  montoConvertido     Decimal?
  descripcion         String
  periodo             String?
  fechaReconciliacion DateTime       @default(now())
  observaciones       String?
  reconciliadoPor     String
  isReconciliada      Boolean?       @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  cuentaBancaria      CuentaBancaria @relation(fields: [cuentaId], references: [cuentaId])
  gastoCompra         GastoCompra?   @relation(fields: [gastoCompraId], references: [gastoCompraId])
  gastoDE             GastosDE?      @relation(fields: [gastosDEId], references: [gastosDEId])
  pagoSalario         Pagosalario?   @relation(fields: [pgId], references: [pgId])
  tipoPago            TipoPago       @relation(fields: [tipoPagoId], references: [tipoId])
}

model AjusteBancario {
  ajusteId        String         @id @default(cuid())
  cuentaId        String
  tipo            String
  monto           Decimal
  moneda          String         @default("CUP")
  tasaCambio      Decimal?
  montoConvertido Decimal?
  descripcion     String
  motivo          String
  realizadoPor    String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cuentaBancaria  CuentaBancaria @relation(fields: [cuentaId], references: [cuentaId])
}

model TransferenciaBancaria {
  transferenciaId     String         @id @default(cuid())
  numeroComprobante   String         @unique
  cuentaOrigenId      String
  cuentaDestinoId     String
  montoOrigen         Decimal
  monedaOrigen        String
  montoDestino        Decimal
  monedaDestino       String
  tasaCambio          Decimal?
  motivo              String
  descripcion         String?
  fechaTransferencia  DateTime       @default(now())
  comprobanteGenerado Boolean        @default(true)
  rutaComprobante     String?
  existe              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  cuentaDestino       CuentaBancaria @relation("TransferenciasDestino", fields: [cuentaDestinoId], references: [cuentaId])
  cuentaOrigen        CuentaBancaria @relation("TransferenciasOrigen", fields: [cuentaOrigenId], references: [cuentaId])
}

model AlertHistory {
  id            String    @id @default(cuid())
  tipoAlerta    String
  severidad     String
  titulo        String
  mensaje       String
  metric        String?
  umbral        Decimal?
  entidadTipo   String?
  entidadId     String?
  moneda        String?
  estado        String    @default("activa")
  revisadaPor   String?
  fechaRevision DateTime?
  notasRevision String?
  fechaAlerta   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  entidad   String
  entidadId String
  accion    String
  usuarioId String
  detalles  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model ReportHistory {
  id               String   @id @default(cuid())
  tipoReporte      String
  formato          String
  nombre           String
  descripcion      String?
  parametros       String?
  resumenEjecutivo String?
  numeroAlertas    Int      @default(0)
  metricasClave    String?
  rutaArchivo      String?
  tamanhoArchivo   Int?
  generadoPor      String
  fechaGeneracion  DateTime @default(now())
  reporteBaseId    String?
  comparacion      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ScheduledReport {
  id                     String    @id @default(cuid())
  nombre                 String
  descripcion            String?
  tipoReporte            String
  formato                String
  parametros             String?
  frecuencia             String
  diaSemana              Int?
  diaMes                 Int?
  hora                   String
  zonaHoraria            String    @default("America/Havana")
  activo                 Boolean   @default(true)
  enviarEmail            Boolean   @default(false)
  destinatarios          String?
  asuntoEmail            String?
  cuerpoEmail            String?
  ultimaEjecucion        DateTime?
  proximaEjecucion       DateTime?
  totalEjecuciones       Int       @default(0)
  ultimaEjecucionExitosa Boolean   @default(true)
  creadoPor              String
  fechaCreacion          DateTime  @default(now())
  ultimaModificacion     DateTime  @updatedAt
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model ScenarioSimulation {
  id                 String   @id @default(cuid())
  nombre             String
  descripcion        String?
  tasasSimuladas     String
  fechaProyeccion    DateTime
  resultados         String
  alertas            String?
  creadoPor          String
  fechaCreacion      DateTime @default(now())
  ultimaModificacion DateTime @updatedAt
  etiquetas          String?
  esFavorito         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Documento {
  documentoId                           String               @id
  tipo                                  TipoDocumento
  titulo                                String
  descripcion                           String?
  estado                                EstadoDocumento      @default(BORRADOR)
  contenido                             Json?
  rutaArchivo                           String?
  numero                                String?
  referencia                            String?
  referenciaTipo                        String?
  ventaId                               String?
  clienteId                             String?
  empleadoId                            String?
  vendorId                              String?
  creadoPorId                           String
  actualizadoPorId                      String?
  fechaEmision                          DateTime?
  fechaVencimiento                      DateTime?
  fechaFirmado                          DateTime?
  categoria                             String?
  etiquetas                             String?
  plantillaId                           String?
  metadata                              Json?
  createdAt                             DateTime             @default(now())
  updatedAt                             DateTime
  User_Documento_actualizadoPorIdToUser User?                @relation("Documento_actualizadoPorIdToUser", fields: [actualizadoPorId], references: [userId])
  Cliente                               Cliente?             @relation(fields: [clienteId], references: [clienteId])
  User_Documento_creadoPorIdToUser      User                 @relation("Documento_creadoPorIdToUser", fields: [creadoPorId], references: [userId])
  Empleado                              Empleado?            @relation(fields: [empleadoId], references: [empleadoId])
  PlantillaDocumento                    PlantillaDocumento?  @relation(fields: [plantillaId], references: [plantillaId])
  Vendor                                Vendor?              @relation(fields: [vendorId], references: [vendorId])
  Venta                                 Venta?               @relation(fields: [ventaId], references: [ventaId])
  DocumentoAcceso                       DocumentoAcceso[]
  DocumentoAuditoria                    DocumentoAuditoria[]
  DocumentoFirma                        DocumentoFirma[]
  DocumentoVersion                      DocumentoVersion[]
}

model DocumentoAcceso {
  accesoId                                 String     @id
  documentoId                              String
  usuarioId                                String
  tipoAcceso                               TipoAcceso
  otorgadoPorId                            String
  activo                                   Boolean    @default(true)
  fechaExpiracion                          DateTime?
  createdAt                                DateTime   @default(now())
  updatedAt                                DateTime
  Documento                                Documento  @relation(fields: [documentoId], references: [documentoId], onDelete: Cascade)
  User_DocumentoAcceso_otorgadoPorIdToUser User       @relation("DocumentoAcceso_otorgadoPorIdToUser", fields: [otorgadoPorId], references: [userId])
  User_DocumentoAcceso_usuarioIdToUser     User       @relation("DocumentoAcceso_usuarioIdToUser", fields: [usuarioId], references: [userId])

  @@unique([documentoId, usuarioId, tipoAcceso])
}

model DocumentoAuditoria {
  auditoriaId String    @id
  documentoId String
  accion      String
  detalles    Json?
  usuarioId   String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  Documento   Documento @relation(fields: [documentoId], references: [documentoId], onDelete: Cascade)
  User        User      @relation(fields: [usuarioId], references: [userId])
}

model DocumentoFirma {
  firmaId       String    @id
  documentoId   String
  firmanteId    String
  firmaDigital  String?
  fechaFirma    DateTime  @default(now())
  ipAddress     String?
  userAgent     String?
  observaciones String?
  createdAt     DateTime  @default(now())
  Documento     Documento @relation(fields: [documentoId], references: [documentoId], onDelete: Cascade)
  User          User      @relation(fields: [firmanteId], references: [userId])
}

model DocumentoVersion {
  versionId     String    @id
  documentoId   String
  numeroVersion Int
  contenido     Json
  rutaArchivo   String?
  motivoCambio  String?
  creadoPorId   String
  createdAt     DateTime  @default(now())
  User          User      @relation(fields: [creadoPorId], references: [userId])
  Documento     Documento @relation(fields: [documentoId], references: [documentoId], onDelete: Cascade)

  @@unique([documentoId, numeroVersion])
}

model PlantillaDocumento {
  plantillaId  String        @id
  nombre       String
  descripcion  String?
  tipo         TipoDocumento
  contenido    Json
  htmlTemplate String?
  cssTemplate  String?
  variables    String?
  activo       Boolean       @default(true)
  categoria    String?
  creadoPorId  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  Documento    Documento[]
  User         User          @relation(fields: [creadoPorId], references: [userId])
}

enum TipoInyeccion {
  CAPITAL_SOCIAL
  DEUDA_EXTERNA
}

enum EstadoDeuda {
  ACTIVA
  PAGADA
  EN_MORA
}

enum TipoDocumento {
  CONTRATO_VENTA
  CONTRATO_PROVEEDOR
  CONTRATO_EMPLEADO
  FACTURA
  NOTA_CREDITO
  NOTA_DEBITO
  REMISION
  ORDEN_COMPRA
  REPORTE
  OTRO
}

enum EstadoDocumento {
  BORRADOR
  PENDIENTE_FIRMA
  FIRMADO
  RECHAZADO
  ANULADO
  ARCHIVADO
}

enum TipoAcceso {
  LECTURA
  ESCRITURA
  FIRMA
  ELIMINACION
  ADMINISTRACION
}

model Tenant {
  tenantId  String   @id @default(cuid())
  nombre    String
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships TenantMembership[]
  licencias   TenantLicense[]

  @@index([slug])
  @@map("tenants")
}

model TenantMembership {
  membershipId String   @id @default(cuid())
  tenantId     String
  userId       String
  tenantRole   String   @default("dependiente")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

model TenantLicense {
  tenantLicenseId String   @id @default(cuid())
  tenantId        String
  planId          String?
  activa          Boolean  @default(true)
  inicio          DateTime @default(now())
  expiracion      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  maxUsuarios     Int      @default(1)
  maxAlmacenes    Int      @default(1)
  maxProductos    Int      @default(100)
  features        Json?

  tenant Tenant @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_licenses")
}
