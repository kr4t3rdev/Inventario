generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  catId                 String      @id @default(cuid())
  tenantId              String
  nombre                String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  descripcion           String?
  parentId              String?
  clasSectionId         String?
  clasSpecificId        String?
  parent                Categoria?  @relation("CategoriaHierarchy", fields: [parentId], references: [catId], onDelete: Cascade)
  subcategorias         Categoria[] @relation("CategoriaHierarchy")
  productos             Producto[]
  productosSubcategoria Producto[]  @relation("ProductoSubcategoria")
  tenant                Tenant      @relation(fields: [tenantId], references: [tenantId])

  @@index([clasSectionId])
  @@index([clasSpecificId])
  @@index([tenantId])
}

model Unidad {
  unidadId  String     @id @default(cuid())
  nombre    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  simbolo   String     @unique
  productos Producto[]
}

model Vendor {
  vendorId         String            @id @default(cuid())
  tenantId         String
  nombre           String
  contacto         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contrato         String?
  cuentaCUP        String?
  cuentaUSD        String?
  direccion        String?
  logo             String?
  telefono         String?
  vendorCode       String?           @db.VarChar(2)
  compras          CompraProducto[]
  compraDocumentos CompraDocumento[]
  contratos        Contrato[]        @relation("ContratoVendor")
  cuentasPorPagar  CuentaPorPagar[]
  deudasCash       DeudaCash[]
  gastoCompras     GastoCompra[]
  anticipos        Anticipo[]
  productos        Producto[]
  compraServicios  CompraServicio[]
  tenant           Tenant            @relation(fields: [tenantId], references: [tenantId])

  @@unique([tenantId, vendorCode])
  @@index([vendorCode])
  @@index([tenantId])
}

model InyeccionCapital {
  id                 String         @id @default(cuid())
  tipo               TipoInyeccion
  montoRecibido      Decimal
  moneda             String         @default("CUP")
  tasaInteres        Decimal?
  montoInteres       Decimal?
  montoTotalDeuda    Decimal?
  saldoPendiente     Decimal?
  plazoMeses         Int?
  fechaInicioPago    DateTime?
  socio              String?
  entidadPrestamista String?
  cuentaId           String
  estado             EstadoDeuda?   @default(ACTIVA)
  descripcion        String?
  fechaRegistro      DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  cuentaBancaria     CuentaBancaria @relation(fields: [cuentaId], references: [cuentaId])
  pagos              PagoDeuda[]
}

model PagoDeuda {
  id             String           @id @default(cuid())
  inyeccionId    String
  montoPagado    Decimal
  fechaPago      DateTime         @default(now())
  cuentaId       String
  numeroCuota    Int?
  comprobante    String?
  observaciones  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cuentaBancaria CuentaBancaria   @relation(fields: [cuentaId], references: [cuentaId])
  inyeccion      InyeccionCapital @relation(fields: [inyeccionId], references: [id], onDelete: Cascade)
}

model Cliente {
  clienteId         String            @id @default(cuid())
  tenantId          String
  nombre            String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  direccion         String?
  logoUrl           String?
  numeroContrato    String?
  numeroCuentaCUP   String?
  numeroCuentaUSD   String?
  telefono          String?
  contratos         Contrato[]        @relation("ContratoCliente")
  cuentasPorCobrar  CuentaPorCobrar[]
  anticipos         Anticipo[]
  ofertas           Oferta[]
  ordenesReparacion OrdenReparacion[]
  prestamosCash     PrestamoCash[]
  Venta             Venta[]
  ventasServicios   VentaServicios[]
  facturas          Factura[]
  tenant            Tenant            @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
}

/// * Modelo base de multi-tenant. Cada empresa/organización es un Tenant.
model Tenant {
  tenantId  String   @id @default(cuid())
  nombre    String
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa                    MiEmpresa?
  memberships                TenantMembership[]
  licencias                  TenantLicense[]
  categorias                 Categoria[]
  vendors                    Vendor[]
  clientes                   Cliente[]
  almacenes                  Almacen[]
  puntosDeVenta              PuntoDeVenta[]
  productos                  Producto[]
  ventas                     Venta[]
  facturas                   Factura[]
  gastosDE                   GastosDE[]
  gastosCompra               GastoCompra[]
  comprasProducto            CompraProducto[]
  comprasDocumento           CompraDocumento[]
  comprasDocumentoItem       CompraDocumentoItem[]
  servicios                  Servicios[]
  ventasServicios            VentaServicios[]
  comprasServicio            CompraServicio[]
  cuentasBancarias           CuentaBancaria[]
  reconciliacionesVenta      ReconciliacionVenta[]
  reconciliacionesServicio   ReconciliacionServicio[]
  reconciliacionesGasto      ReconciliacionGasto[]
  ajustesBancarios           AjusteBancario[]
  transferenciasBancarias    TransferenciaBancaria[]
  contratos                  Contrato[]
  seriesFacturacion          SerieFacturacion[]
  ofertas                    Oferta[]
  cuentasPorCobrar           CuentaPorCobrar[]
  cuentasPorPagar            CuentaPorPagar[]
  deudasCash                 DeudaCash[]
  prestamosCash              PrestamoCash[]
  pagosCuentaPorPagar        PagoCuentaPorPagar[]
  empleados                  Empleado[]
  ordenesProduccion          OrdenProduccion[]
  ordenesProduccionHistorial OrdenProduccionHistorial[]
  recetas                    Receta[]
  recetasIngredientes        RecetaIngrediente[]
  valesSalida                ValeSalida[]
  valesSalidaItem            ValeSalidaItem[]
  listasPrecio               ListaPrecio[]
  equiposReparacion          EquipoReparacion[]
  piezasReparacion           PiezaReparacion[]
  ordenesReparacion          OrdenReparacion[]
  ordenesReparacionEquipo    OrdenReparacionEquipo[]
  ordenesReparacionItem      OrdenReparacionItem[]
  ordenesReparacionMaterial  OrdenReparacionMaterial[]
  defectacionesCatalogo      DefectacionCatalogo[]
  anticipos                  Anticipo[]
  transferencias             Transferencia[]
  mermas                     Merma[]
  stockUbicaciones           StockUbicacion[]
  pagosSalario               Pagosalario[]
  cierresContables           CierreContable[]
  periodosContables          PeriodoContable[]
  aperturaPeriodos           AperturaPeriodo[]
  auditoriaPeriodos          AuditoriaPeriodo[]
  turnosPos                  TurnoPuntoVenta[]
  arqueosCaja                ArqueoCaja[]
  backupLogs                 BackupLog[]
  backupPlans                BackupPlan[]
  contabilidadTimezone       String                     @default("America/Argentina/Buenos_Aires")

  @@index([slug])
  @@map("tenants")
}

/// * Membresía de un usuario en un tenant. Desacopla identidad global de rol operativo.
model TenantMembership {
  membershipId String   @id @default(cuid())
  tenantId     String
  userId       String
  tenantRole   String   @default("dependiente")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

/// * Licencia/plan activo de un tenant. Reemplaza la relación actual Licencia→User.
model TenantLicense {
  tenantLicenseId String   @id @default(cuid())
  tenantId        String
  planId          String?
  activa          Boolean  @default(true)
  inicio          DateTime @default(now())
  expiracion      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  maxUsuarios     Int      @default(1)
  maxAlmacenes    Int      @default(1)
  maxProductos    Int      @default(100)
  features        Json?

  tenant Tenant @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  plan   Plan?  @relation(fields: [planId], references: [planId])

  @@index([tenantId])
  @@index([planId])
  @@map("tenant_licenses")
}

model MiEmpresa {
  id                Int             @id @default(1)
  tenantId          String?         @unique
  nombre            String          @default("Mi Empresa")
  propietario       String?
  direccion         String?
  telefono          String?
  email             String?
  carnetIdentidad   String?
  nit               String?
  licenciaOperacion String?
  logoUrl           String?
  cuentaBancariaId  String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  usaCodigoEan13    Boolean         @default(false)
  tenant            Tenant?         @relation(fields: [tenantId], references: [tenantId])
  cuentaBancaria    CuentaBancaria? @relation("MiEmpresaCuenta", fields: [cuentaBancariaId], references: [cuentaId])
}

model Almacen {
  almacenId             String          @id @default(cuid())
  tenantId              String
  nombre                String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  productos             Producto[]
  puntosDeVenta         PuntoDeVenta[]
  transferenciasDestino Transferencia[] @relation("TransferenciasDestino")
  transferenciasOrigen  Transferencia[] @relation("TransferenciasOrigen")
  tenant                Tenant          @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
}

model PuntoDeVenta {
  pvId                  String            @id @default(cuid())
  tenantId              String
  nombre                String
  ubicacion             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  listaPrecioId         String?
  tipoCaja              String?           @default("PRINCIPAL")
  almacenId             String?
  cuentaContableId      String?
  productos             Producto[]
  listaPrecio           ListaPrecio?      @relation(fields: [listaPrecioId], references: [id])
  almacen               Almacen?          @relation(fields: [almacenId], references: [almacenId])
  transferenciasDestino Transferencia[]   @relation("TransferenciasDestino")
  transferenciasOrigen  Transferencia[]   @relation("TransferenciasOrigen")
  ventas                Venta[]
  turnos                TurnoPuntoVenta[]
  arqueos               ArqueoCaja[]
  tenant                Tenant            @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
}

model TurnoPuntoVenta {
  id              String      @id @default(cuid())
  tenantId        String
  puntoDeVentaId  String
  empleadoId      String?
  tipo            String      @default("NORMAL")
  fechaApertura   DateTime    @default(now())
  fechaCierre     DateTime?
  fondoInicialCup Int         @default(0)
  fondoInicialUsd Int         @default(0)
  estado          EstadoTurno @default(ABIERTO)
  observaciones   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  puntoDeVenta PuntoDeVenta @relation(fields: [puntoDeVentaId], references: [pvId])
  empleado     Empleado?    @relation(fields: [empleadoId], references: [empleadoId])
  ventas       Venta[]
  arqueo       ArqueoCaja?
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
  @@index([puntoDeVentaId, fechaApertura])
  @@map("turnos_punto_venta")
}

model ArqueoCaja {
  id             String @id @default(cuid())
  turnoId        String @unique
  tenantId       String
  puntoDeVentaId String

  billetes1000Cup Int @default(0)
  billetes500Cup  Int @default(0)
  billetes200Cup  Int @default(0)
  billetes100Cup  Int @default(0)
  billetes50Cup   Int @default(0)
  billetes20Cup   Int @default(0)
  monedasCup      Int @default(0)

  billetes100Usd Int @default(0)
  billetes50Usd  Int @default(0)
  billetes20Usd  Int @default(0)
  billetes10Usd  Int @default(0)
  billetes5Usd   Int @default(0)
  billetes1Usd   Int @default(0)
  monedasUsd     Int @default(0)

  totalEfectivoCup   Int @default(0)
  totalEfectivoUsd   Int @default(0)
  totalTarjeta       Int @default(0)
  totalTransferencia Int @default(0)
  totalCredito       Int @default(0)

  esperadoEfectivoCup   Int @default(0)
  esperadoEfectivoUsd   Int @default(0)
  esperadoTarjeta       Int @default(0)
  esperadoTransferencia Int @default(0)
  esperadoCredito       Int @default(0)

  diferenciaCup Int @default(0)
  diferenciaUsd Int @default(0)

  observaciones String?
  contabilizado Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  turno        TurnoPuntoVenta @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  puntoDeVenta PuntoDeVenta    @relation(fields: [puntoDeVentaId], references: [pvId])
  tenant       Tenant          @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
  @@index([puntoDeVentaId])
  @@map("arqueos_caja")
}

model Producto {
  nombre               String
  tenantId             String
  descripcion          String?
  precioCosto          Int
  precioVenta          Int
  stock                Int
  categoriaId          String
  unidadId             String?
  vendorId             String?
  createdAt            DateTime                  @default(now())
  id                   String                    @id @default(cuid())
  updatedAt            DateTime                  @updatedAt
  esCompuesto          Boolean                   @default(false)
  almacenId            String
  puntoDeVentaId       String?
  stockMinimo          Int                       @default(0)
  subcategoriaId       String?
  cantidadEnPack       Int?
  productoPadreId      String?
  codigoInterno        String?                   @db.VarChar(11)
  codigoNegocio        String?
  proveedorCodigo      String?
  idSeccionCodigo      String?
  especificoCodigo     String?
  surtidoCodigo        String?
  dcCodigo             String?
  fotos                String[]                  @default([])
  compras              CompraProducto[]
  compraDocumentoItems CompraDocumentoItem[]
  gastoCompras         GastoCompra[]
  mermas               Merma[]
  ofertaItems          OfertaItem[]
  ordenMateriales      OrdenReparacionMaterial[]
  precios              PrecioProducto[]
  almacen              Almacen                   @relation(fields: [almacenId], references: [almacenId], onDelete: Cascade)
  categoria            Categoria                 @relation(fields: [categoriaId], references: [catId], onDelete: Cascade)
  puntoDeVenta         PuntoDeVenta?             @relation(fields: [puntoDeVentaId], references: [pvId], onDelete: Cascade)
  productoPadre        Producto?                 @relation("ProductoCompuesto", fields: [productoPadreId], references: [id])
  productosHijos       Producto[]                @relation("ProductoCompuesto")
  subcategoria         Categoria?                @relation("ProductoSubcategoria", fields: [subcategoriaId], references: [catId])
  unidad               Unidad?                   @relation(fields: [unidadId], references: [unidadId], onDelete: Cascade)
  vendor               Vendor?                   @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  tenant               Tenant                    @relation(fields: [tenantId], references: [tenantId])
  costHistory          ProductoCostHistory[]
  Receta               Receta[]
  RecetaIngrediente    RecetaIngrediente[]
  transferencias       Transferencia[]
  ValeSalidaItem       ValeSalidaItem[]
  ventas               Venta[]
  ventaItems           VentaItem[]
  stockUbicaciones     StockUbicacion[]

  @@unique([tenantId, codigoInterno])
  @@unique([tenantId, codigoNegocio])
  @@index([tenantId])
  @@index([tenantId, categoriaId])
  @@index([tenantId, vendorId])
}

model StockUbicacion {
  id                 String   @id @default(cuid())
  tenantId           String
  productoId         String
  tipoUbicacion      String // "almacen" | "punto_venta"
  ubicacionId        String // Almacen.almacenId o PuntoDeVenta.pvId
  cantidad           Int      @default(0)
  cantidadReservada  Int      @default(0)
  cantidadDisponible Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  producto           Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tenant             Tenant   @relation(fields: [tenantId], references: [tenantId])

  @@unique([productoId, tipoUbicacion, ubicacionId])
  @@index([tenantId])
  @@index([ubicacionId, tipoUbicacion])
  @@index([productoId])
}

model Venta {
  ventaId            String                @id @default(cuid())
  tenantId           String
  productoId         String?
  cantidad           Int
  puntoDeVentaId     String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  empleadoId         String?
  total              Int?
  clienteId          String?
  ordenId            String?
  descuento          Int?
  observaciones      String?
  esVentaUnica       Boolean               @default(false)
  ofertaId           String?               @unique
  ventaPadreId       String?
  turnoId            String?
  metodoPago         MetodoPagoVenta?
  montoEfectivo      Int?
  montoTarjeta       Int?
  montoTransferencia Int?
  montoCredito       Int?
  ordenReparacion    OrdenReparacion?      @relation("OrdenVenta")
  reconciliaciones   ReconciliacionVenta[]
  cliente            Cliente?              @relation(fields: [clienteId], references: [clienteId], onDelete: Cascade)
  empleado           Empleado?             @relation(fields: [empleadoId], references: [empleadoId])
  oferta             Oferta?               @relation(fields: [ofertaId], references: [id])
  producto           Producto?             @relation(fields: [productoId], references: [id], onDelete: Cascade)
  puntoDeVenta       PuntoDeVenta          @relation(fields: [puntoDeVentaId], references: [pvId])
  turno              TurnoPuntoVenta?      @relation(fields: [turnoId], references: [id])
  factura            Factura?
  items              VentaItem[]
  tenant             Tenant                @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([turnoId])
}

model VentaItem {
  id             String   @id @default(cuid())
  ventaId        String
  productoId     String
  cantidad       Int
  precioUnitario Int
  total          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  venta          Venta    @relation(fields: [ventaId], references: [ventaId], onDelete: Cascade)

  @@map("venta_items")
}

model Merma {
  mermaId    String   @id @default(cuid())
  tenantId   String
  productoId String
  cantidad   Int
  motivo     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  costoTotal Int?
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
}

model Transferencia {
  transferenciaId       String        @id @default(cuid())
  tenantId              String
  productoId            String
  cantidad              Int
  origenId              String?
  destinoId             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  descripcion           String?
  costoUnitario         Int?
  costoTotal            Int?
  deletedAt             DateTime?
  estado                String        @default("COMPLETADA")
  numeroTransferencia   String?       @unique
  creadoPorId           String?
  puntoDeVentaDestinoId String?
  puntoDeVentaOrigenId  String?
  destino               Almacen?      @relation("TransferenciasDestino", fields: [destinoId], references: [almacenId])
  origen                Almacen?      @relation("TransferenciasOrigen", fields: [origenId], references: [almacenId])
  producto              Producto      @relation(fields: [productoId], references: [id], onDelete: Cascade)
  creadoPor             User?         @relation(fields: [creadoPorId], references: [userId], onDelete: SetNull)
  puntoDeVentaDestino   PuntoDeVenta? @relation("TransferenciasDestino", fields: [puntoDeVentaDestinoId], references: [pvId])
  puntoDeVentaOrigen    PuntoDeVenta? @relation("TransferenciasOrigen", fields: [puntoDeVentaOrigenId], references: [pvId])
  tenant                Tenant        @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
}

model User {
  userId                   String               @id @default(cuid())
  name                     String
  email                    String               @unique
  password                 String
  googleId                 String?              @unique
  role                     String               @default("regularUser")
  onboardingType           String?
  onboardingStatus         String               @default("pending_email_verification")
  emailVerifiedAt          DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  activatedAt              DateTime?
  avatar                   String?
  expiresAt                DateTime?
  isActive                 Boolean              @default(true)
  lastFailedLogin          DateTime?
  lastModifiedBy           String?
  lockedUntil              DateTime?
  loginAttempts            Int                  @default(0)
  contratosAprobados       Contrato[]           @relation("AprobadorContrato")
  contratosCreados         Contrato[]           @relation("CreadorContrato")
  contratoAprobaciones     ContratoAprobacion[]
  contratoArchivos         ContratoArchivo[]
  contratoFirmas           ContratoFirma[]
  contratoVersiones        ContratoVersion[]
  tiposContratosCustom     TipoContratoCustom[]
  licencias                Licencia[]
  licenciasAudit           LicenciaAudit[]      @relation("LicenciaAuditActor")
  notifications            Notification[]
  activityLogs             UserActivityLog[]
  sessions                 UserSession[]
  tenantMemberships        TenantMembership[]
  anticiposCreados         Anticipo[]
  compraDocumentosEditados CompraDocumento[]    @relation("CompraDocumentoActualizado")
  transferenciasCreadas    Transferencia[]
  backupLogs               BackupLog[]
  backupPlans              BackupPlan[]
}

model Plan {
  planId         String          @id @default(cuid())
  nombre         String
  descripcion    String?
  precio         Decimal         @default(0)
  duracionDias   Int
  maxUsuarios    Int             @default(1)
  maxAlmacenes   Int             @default(1)
  maxProductos   Int             @default(100)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  licencias      Licencia[]
  tenantLicenses TenantLicense[]
}

model Licencia {
  licenciaId String          @id @default(cuid())
  clave      String          @unique
  usuarioId  String
  planId     String
  activa     Boolean         @default(true)
  inicio     DateTime        @default(now())
  expiracion DateTime
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  plan       Plan            @relation(fields: [planId], references: [planId], onDelete: Cascade)
  usuario    User            @relation(fields: [usuarioId], references: [userId], onDelete: Cascade)
  auditoria  LicenciaAudit[]

  @@index([usuarioId])
  @@index([planId])
}

model LicenciaAudit {
  licenciaId      String?
  accion          String
  detalles        String?
  realizadoPor    String?
  ip              String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  licenciaAuditId String    @id @default(cuid())
  licencia        Licencia? @relation(fields: [licenciaId], references: [licenciaId], onDelete: Cascade)
  actor           User?     @relation("LicenciaAuditActor", fields: [realizadoPor], references: [userId])

  @@index([licenciaId])
  @@index([realizadoPor])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  userId    String
