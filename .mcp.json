{
  "mcpServers": {
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ],
      "directTools": true
    },
    "vercel": {
      "url": "https://mcp.vercel.com",
      "directTools": true
    },
    "testsprite": {
      "command": "npx",
      "args": [
        "-y",
        "@testsprite/testsprite-mcp"
      ]
    },
    "railway": {
      "command": "railway",
      "args": [
        "mcp"
      ],
      "directTools": true
    }
  }
}
