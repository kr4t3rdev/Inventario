{
  "name": "invent-sys",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_TELEMETRY_DISABLED=1 next build",
    "build:fast": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=6144' tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "seed:implementacion": "tsx prisma/seed/implementation-seed.ts",
    "seed:qa": "tsx prisma/seed/qa-scenarios-seed.ts",
    "seed:plans": "tsx prisma/seed/plans-seed.ts",
    "seed:upload-backfill": "tsx prisma/seed/backfill-upload-features.ts",
    "ops:baseline-prisma-production": "tsx scripts/ops/baseline-prisma-production.ts --dry-run",
    "ops:sync-plan-features-production": "tsx scripts/ops/sync-plan-features-production.ts",
    "seed:licenses": "tsx prisma/seed/tenant-licenses-seed.ts",
    "report:qa": "tsx prisma/seed/qa-report.ts",
    "testsprite": "npx -y @testsprite/testsprite-mcp",
    "sync:setup": "npx tsx scripts/setup-supabase.ts",
    "sync:local-to-supabase": "npx tsx scripts/sync-to-supabase.ts",
    "sync:validate": "npx tsx scripts/validate-integrity.ts",
    "sync:full": "npm run sync:setup && npm run sync:validate && npm run sync:local-to-supabase",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:affiliate:railway": "RUN_AFFILIATE_RAILWAY_TEST=1 vitest run --pool forks src/features/affiliate/actions.integration.test.ts",
    "remotion:preview": "remotion preview remotion/index.ts",
    "remotion:render": "remotion render remotion/index.ts Battle-Short out/battle-short.mp4",
    "remotion:render-404": "remotion render remotion/index.ts NotFoundAnimation out/404-animation.mp4",
    "remotion:render-404-gif": "remotion render remotion/index.ts NotFoundAnimation out/404-animation.gif --format gif",
    "test:live": "vitest run --config vitest.live.config.mjs",
    "depgraph": "depcruise src --output-type dot | dot -T svg > docs/depgraph.svg",
    "depgraph:html": "depcruise src --output-type dot | dot -T svg > docs/depgraph.svg",
    "depgraph:archi": "depcruise src --output-type archi | dot -T svg > docs/depgraph-archi.svg",
    "depgraph:full": "depcruise src --output-type dot --progress -x '(node_modules|__tests__|\\.test\\.|\\.spec\\.|\\.next)' | dot -T svg > docs/depgraph-full.svg",
    "depgraph:open": "depcruise src --output-type dot | dot -T svg > docs/depgraph.svg && open docs/depgraph.svg",
    "depgraph:mermaid": "depcruise src --output-type mermaid > docs/depgraph.mmd",
    "depgraph:mermaid:view": "depcruise src --output-type mermaid > docs/depgraph.mmd && open docs/depgraph.mermaid.html",
    "depgraph:validate": "depcruise src",
    "prepare": "husky",
    "seed:referral-perks": "tsx prisma/seed/referral-perks-seed.ts",
    "openapi:lint": "redocly lint mobile-v1",
    "openapi:parity": "vitest run src/lib/openapi/mobile-v1-contract.test.ts src/lib/openapi/mobile-v1-hardening.test.ts src/lib/openapi/mobile-v1-sdks.test.ts",
    "mobile:smoke": "vitest run src/lib/openapi/mobile-v1-integration-smoke.test.ts",
    "openapi:generate": "node scripts/openapi/generate.mjs",
    "openapi:generate:check": "node scripts/openapi/check-generated.mjs",
    "openapi:check": "pnpm run openapi:lint && pnpm run openapi:parity && pnpm run mobile:smoke && pnpm run openapi:generate:check",
    "ops:monitor:accounting-reports": "tsx scripts/ops/accounting-reports-monitor.ts",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "e2e:prep": "playwright test --config playwright.cart.config.ts e2e/prep-auth.spec.ts",
    "test:smoke:prod": "playwright test --config playwright.smoke.config.ts",
    "test:ci:contracts": "vitest run --config vitest.ci-contract.config.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.4",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/engines": "^7.10.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@prisma/instrumentation": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remotion/player": "^4.0.525",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-table": "^9.2.4",
    "@types/bcryptjs": "^3.0.0",
    "@uploadthing/react": "^7.3.3",
    "@upstash/redis": "^1.38.4",
    "@vercel/blob": "^2.8.0",
    "@vercel/otel": "^2.1.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "formidable": "^3.5.4",
    "framer-motion": "^13.3.0",
    "fuse.js": "^7.5.0",
    "google-auth-library": "^11.0.2",
    "googleapis": "^181.0.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.46.0",
    "mermaid": "^12.0.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.2",
    "react-hook-form": "^7.88.0",
    "react-hook-toast": "^0.0.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.28.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uploadthing": "^7.7.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@fast-check/vitest": "^0.2.4",
    "@playwright/test": "^1.59.1",
    "@prisma/client": "^6.19.0",
    "@redocly/cli": "2.46.0",
    "@remotion/cli": "^4.0.417",
    "@supabase/supabase-js": "^2.86.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@testsprite/testsprite-mcp": "^0.0.19",
    "@types/date-fns": "^2.5.3",
    "@types/formidable": "^3.4.5",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/jspdf": "^1.3.3",
    "@types/next-auth": "^3.13.0",
    "@types/node": "^20.19.25",
    "@types/nodemailer": "^7.0.9",
    "@types/pdfkit": "^0.17.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-day-picker": "^5.2.1",
    "@types/react-dom": "19.3.0",
    "@types/xlsx": "^0.0.35",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fast-check": "^4.5.3",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.7",
    "prisma": "^6.19.0",
    "remotion": "^4.0.417",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5.9.3",
    "unlighthouse": "^0.17.4",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --quiet"
    ],
    "*.{json,css,md}": [
      "eslint --fix --quiet"
    ]
  }
}
