{
  "name": "invent-sys",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_TELEMETRY_DISABLED=1 next build",
    "build:fast": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "seed:implementacion": "tsx prisma/seed/implementation-seed.ts",
    "seed:qa": "tsx prisma/seed/qa-scenarios-seed.ts",
    "seed:plans": "tsx prisma/seed/plans-seed.ts",
    "seed:upload-backfill": "tsx prisma/seed/backfill-upload-features.ts",
    "seed:licenses": "tsx prisma/seed/tenant-licenses-seed.ts",
    "report:qa": "tsx prisma/seed/qa-report.ts",
    "testsprite": "npx -y @testsprite/testsprite-mcp",
    "sync:setup": "npx tsx scripts/setup-supabase.ts",
    "sync:local-to-supabase": "npx tsx scripts/sync-to-supabase.ts",
    "sync:validate": "npx tsx scripts/validate-integrity.ts",
    "sync:full": "npm run sync:setup && npm run sync:validate && npm run sync:local-to-supabase",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "remotion:preview": "remotion preview remotion/index.ts",
    "remotion:render": "remotion render remotion/index.ts Battle-Short out/battle-short.mp4",
    "remotion:render-404": "remotion render remotion/index.ts NotFoundAnimation out/404-animation.mp4",
    "remotion:render-404-gif": "remotion render remotion/index.ts NotFoundAnimation out/404-animation.gif --format gif",
    "test:live": "vitest run --config vitest.live.config.mjs",
    "depgraph": "depcruise src --output-type dot | dot -T svg > docs/depgraph.svg",
    "depgraph:html": "depcruise src --output-type dot | dot -T svg > docs/depgraph.svg",
    "depgraph:archi": "depcruise src --output-type archi | dot -T svg > docs/depgraph-archi.svg",
    "depgraph:full": "depcruise src --output-type dot --progress -x '(node_modules|__tests__|\\.test\\.|\\.spec\\.|\\.next)' | dot -T svg > docs/depgraph-full.svg",
    "depgraph:open": "depcruise src --output-type dot | dot -T svg > docs/depgraph.svg && open docs/depgraph.svg",
    "depgraph:mermaid": "depcruise src --output-type mermaid > docs/depgraph.mmd",
    "depgraph:mermaid:view": "depcruise src --output-type mermaid > docs/depgraph.mmd && open docs/depgraph.mermaid.html",
    "depgraph:validate": "depcruise src",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.22.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.0.1",
    "@neondatabase/serverless": "^1.0.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/engines": "^6.7.0",
    "@prisma/extension-accelerate": "^1.3.0",
    "@prisma/instrumentation": "^7.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-toggle": "^1.1.8",
    "@radix-ui/react-toggle-group": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@remotion/player": "^4.0.417",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-table": "^8.21.3",
    "@types/bcryptjs": "^2.4.6",
    "@uploadthing/react": "^7.3.3",
    "@upstash/redis": "^1.36.2",
    "@vercel/blob": "^2.4.0",
    "@vercel/otel": "^2.1.2",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.31.0",
    "fuse.js": "^7.4.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.508.0",
    "mermaid": "^11.15.0",
    "next": "16.2.4",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.1",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "react": "19.2.5",
    "react-day-picker": "^9.7.0",
    "react-dom": "19.2.5",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.56.4",
    "react-hook-toast": "^0.0.3",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "shadcn": "^2.7.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "uploadthing": "^7.7.4",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@fast-check/vitest": "^0.2.4",
    "@playwright/test": "^1.59.1",
    "@prisma/client": "^6.19.0",
    "@remotion/cli": "^4.0.417",
    "@supabase/supabase-js": "^2.86.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@testsprite/testsprite-mcp": "^0.0.19",
    "@types/date-fns": "^2.5.3",
    "@types/formidable": "^3.4.5",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/jspdf": "^1.3.3",
    "@types/next-auth": "^3.13.0",
    "@types/node": "^20.19.25",
    "@types/nodemailer": "^7.0.9",
    "@types/pdfkit": "^0.17.2",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-day-picker": "^5.2.1",
    "@types/react-dom": "19.2.3",
    "@types/xlsx": "^0.0.35",
    "@vitest/ui": "^3.2.4",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "fast-check": "^4.5.3",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.7",
    "prisma": "^6.19.0",
    "remotion": "^4.0.417",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5.9.3",
    "unlighthouse": "^0.17.4",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --quiet"
    ],
    "*.{json,css,md}": [
      "eslint --fix --quiet"
    ]
  }
}
