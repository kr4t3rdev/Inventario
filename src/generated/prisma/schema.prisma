  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  ordenes                OrdenReparacion[]
  ordenReparacionEquipos OrdenReparacionEquipo[]
  piezas                 PiezaReparacion[]
}

model PiezaReparacion {
  id           String                @id @default(cuid())
  nombre       String
  equipoId     String
  costoPequeno Decimal
  costoMediano Decimal
  costoGrande  Decimal
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  items        OrdenReparacionItem[]
  equipo       EquipoReparacion      @relation(fields: [equipoId], references: [id], onDelete: Cascade)
}

model OrdenReparacion {
  id                 String                    @id @default(cuid())
  numeroOrden        Int                       @default(autoincrement())
  clienteId          String
  equipoTipoId       String
  marca              String
  modelo             String?
  numeroSerie        String?
  contrasena         String?
  accesorios         String?
  problemaReportado  String
  diagnosticoTecnico String?
  estado             EstadoOrden               @default(RECIBIDO)
  prioridad          String                    @default("normal")
  esGarantia         Boolean                   @default(false)
  fechaRecepcion     DateTime                  @default(now())
  fechaEstimada      DateTime?
  fechaEntrega       DateTime?
  tecnicoId          String?
  subtotal           Decimal                   @default(0)
  descuento          Decimal                   @default(0)
  total              Decimal                   @default(0)
  ventaId            String?                   @unique
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  fotos              String[]                  @default([])
  complejidad        ComplejidadReparacion?
  moneda             String                    @default("USD")
  cliente            Cliente                   @relation(fields: [clienteId], references: [clienteId])
  equipoTipo         EquipoReparacion          @relation(fields: [equipoTipoId], references: [id])
  tecnico            Empleado?                 @relation(fields: [tecnicoId], references: [empleadoId])
  venta              Venta?                    @relation("OrdenVenta", fields: [ventaId], references: [ventaId])
  equipos            OrdenReparacionEquipo[]
  items              OrdenReparacionItem[]
  materiales         OrdenReparacionMaterial[]
}

model OrdenReparacionEquipo {
  id                String                @id @default(cuid())
  ordenId           String
  equipoTipoId      String
  marca             String
  modelo            String?
  numeroSerie       String?
  contrasena        String?
  accesorios        String?
  fotos             String[]              @default([])
  problemaReportado String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  equipoTipo        EquipoReparacion      @relation(fields: [equipoTipoId], references: [id])
  orden             OrdenReparacion       @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  items             OrdenReparacionItem[]
}

model OrdenReparacionItem {
  id            String                 @id @default(cuid())
  ordenId       String
  piezaId       String?
  complejidad   ComplejidadReparacion?
  precio        Decimal
  observaciones String?
  tecnicoId     String?
  defectacionId String?
  ordenEquipoId String?
  defectacion   DefectacionCatalogo?   @relation(fields: [defectacionId], references: [id])
  ordenEquipo   OrdenReparacionEquipo? @relation(fields: [ordenEquipoId], references: [id])
  orden         OrdenReparacion        @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  pieza         PiezaReparacion?       @relation(fields: [piezaId], references: [id])
}

model OrdenReparacionMaterial {
  id             String          @id @default(cuid())
  ordenId        String
  productoId     String
  cantidad       Int
  precioUnitario Decimal
  total          Decimal
  orden          OrdenReparacion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  producto       Producto        @relation(fields: [productoId], references: [id])
}

model DefectacionCatalogo {
  id        String                @id @default(cuid())
  defecto   String
  costo     Int
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  items     OrdenReparacionItem[]
}

model ConfiguracionSistema {
  configId                     String   @id @default(cuid())
  diasAvisoVencimientoContrato Int      @default(30)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model OrdenProduccion {
  ordenProduccionId        String                     @id
  recetaId                 String
  cantidad                 Int
  estado                   EstadoProduccion           @default(PENDIENTE)
  observaciones            String?                    @db.VarChar(1000)
  fechaProduccion          DateTime                   @default(now())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  costoMateriales          Float?
  Receta                   Receta                     @relation(fields: [recetaId], references: [recetaId], onDelete: Cascade)
  OrdenProduccionHistorial OrdenProduccionHistorial[]
}

model OrdenProduccionHistorial {
  ordenProduccionId String
  estadoAnterior    String
  estadoNuevo       String
  observaciones     String?
  usuarioId         String?
  createdAt         DateTime        @default(now())
  id                String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  OrdenProduccion   OrdenProduccion @relation(fields: [ordenProduccionId], references: [ordenProduccionId], onDelete: Cascade)
}

model Receta {
  recetaId          String              @id
  nombre            String              @db.VarChar(160)
  rendimiento       Int                 @default(1)
  costoUnitario     Float               @default(0)
  instrucciones     String?             @db.VarChar(4000)
  tiempoPrep        Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  productoId        String?
  OrdenProduccion   OrdenProduccion[]
  Producto          Producto?           @relation(fields: [productoId], references: [id])
  RecetaIngrediente RecetaIngrediente[]
}

model RecetaIngrediente {
  recetaId      String
  productoId    String
  cantidad      Float
  desperdicio   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  id            String   @id
  unidadSimbolo String?
  Producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  Receta        Receta   @relation(fields: [recetaId], references: [recetaId], onDelete: Cascade)
}

model ValeSalida {
  valeSalidaId   String           @id
  concepto       String           @db.VarChar(200)
  observaciones  String?          @db.VarChar(1000)
  estado         String           @default("COMPLETADO")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  ValeSalidaItem ValeSalidaItem[]
}

model ValeSalidaItem {
  valeSalidaItemId String     @id
  valeSalidaId     String
  productoId       String
  cantidad         Int
  createdAt        DateTime   @default(now())
  Producto         Producto   @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ValeSalida       ValeSalida @relation(fields: [valeSalidaId], references: [valeSalidaId], onDelete: Cascade)
}

model ListaPrecio {
  id            String           @id @default(cuid())
  nombre        String
  descripcion   String?
  esDefault     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  precios       PrecioProducto[]
  puntosDeVenta PuntoDeVenta[]
}

model PrecioProducto {
  id            String      @id @default(cuid())
  listaPrecioId String
  productoId    String
  precio        Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  listaPrecio   ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  producto      Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([listaPrecioId, productoId])
}

model ProductoCostHistory {
  id             String           @id @default(cuid())
  productoId     String
  oldPrecioCosto Int
  newPrecioCosto Int
  oldPrecioVenta Int
  newPrecioVenta Int
  reason         CostChangeReason
  changedBy      String
  changedAt      DateTime
  notes          String?
  createdAt      DateTime         @default(now())
  producto       Producto         @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
  @@index([changedAt])
  @@index([reason])
}

model VendorCodeSequence {
  id         Int @id @default(1)
  nextNumber Int @default(1)
}

enum TipoAnticipo {
  PAGO
  COBRO
}

enum EstadoAnticipo {
  RESERVADO
  EJECUTADO
  ANULADO
}

enum ContextoAnticipo {
  COMPRA_PRODUCTO
  COMPRA_SERVICIO
  FACTURA_OFERTA
  FACTURA_DIRECTA
}

model Anticipo {
  anticipoId        String               @id @default(cuid())
  tipo              TipoAnticipo
  estado            EstadoAnticipo       @default(RESERVADO)
  contratoId        String
  proveedorId       String?
  clienteId         String?
  facturaId         String?              @unique
  compraProductoId  String?              @unique
  montoOriginal     Decimal
  saldoDisponible   Decimal
  moneda            String               @default("CUP")
  cuentaOrigenId    String?
  tipoPagoOrigenId  String?
  referenciaExterna String?
  vigenciaHasta     DateTime?
  fechaReserva      DateTime             @default(now())
  fechaEjecucion    DateTime?
  createdById       String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  contrato          Contrato             @relation(fields: [contratoId], references: [contratoId])
  proveedor         Vendor?              @relation(fields: [proveedorId], references: [vendorId])
  cliente           Cliente?             @relation(fields: [clienteId], references: [clienteId])
  factura           Factura?             @relation(fields: [facturaId], references: [idFactura])
  compraProducto    CompraProducto?      @relation(fields: [compraProductoId], references: [compraProductoId])
  creador           User                 @relation(fields: [createdById], references: [userId])
  movimientos       AnticipoMovimiento[]

  @@index([contratoId])
  @@index([proveedorId])
  @@index([clienteId])
  @@index([facturaId])
  @@index([compraProductoId])
  @@index([estado])
  @@index([tipo])
}

model AnticipoMovimiento {
  movimientoId          String            @id @default(cuid())
  anticipoId            String
  tipoMovimiento        String
  contexto              ContextoAnticipo?
  documentoDestinoId    String?
  reconciliacionVentaId String?
  reconciliacionGastoId String?
  monto                 Decimal
  moneda                String
  tasaAplicada          Decimal?
  montoConvertido       Decimal?
  saldoAntes            Decimal
  saldoDespues          Decimal
  usuarioId             String
  idempotencyKey        String?
  observaciones         String?
  createdAt             DateTime          @default(now())
  anticipo              Anticipo          @relation(fields: [anticipoId], references: [anticipoId], onDelete: Cascade)

  @@unique([anticipoId, idempotencyKey])
  @@index([anticipoId, createdAt])
  @@index([documentoDestinoId])
}

enum TipoInyeccion {
  CAPITAL_SOCIAL
  DEUDA_EXTERNA
}

enum EstadoDeuda {
  ACTIVA
  PAGADA
  EN_MORA
}

enum EstadoContrato {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
  ACTIVO
  FINALIZADO
  ANULADO
}

enum TipoFirma {
  CLIENTE
  PROVEEDOR
  INTERNO
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  ANULADA
  VENCIDA
}

enum TipoDocumento {
  FACTURA
  NOTA_CREDITO
  FACTURA_RECTIFICATIVA
  PROFORMA
}

enum EstadoOferta {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  FACTURADA
}

enum EstadoCuentaPorCobrar {
  PENDIENTE
  PAGADA
  PARCIAL
}

enum TipoCuentaPorPagar {
  compra
  servicio
}

enum EstadoCuentaPorPagar {
  PENDIENTE
  PAGADA
  PARCIAL
}

enum EstadoOrden {
  RECIBIDO
  EN_DIAGNOSTICO
  ESPERANDO_APROBACION
  EN_REPARACION
  ESPERANDO_REPUESTOS
  TERMINADO
  ENTREGADO
  CANCELADO
}

enum ComplejidadReparacion {
  PEQUENO
  MEDIANO
  GRANDE
}

enum EstadoProduccion {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum CostChangeReason {
  INITIAL
  RESTOCK
  ADJUSTMENT
  CORRECTION
  IMPORT
  MANUAL_EDIT
  SYSTEM_SYNC
}
