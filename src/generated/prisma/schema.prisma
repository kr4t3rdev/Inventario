generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  catId                 String      @id @default(cuid())
  nombre                String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  descripcion           String?
  parentId              String?
  clasSectionId         String?
  clasSpecificId        String?
  parent                Categoria?  @relation("CategoriaHierarchy", fields: [parentId], references: [catId], onDelete: Cascade)
  subcategorias         Categoria[] @relation("CategoriaHierarchy")
  productos             Producto[]
  productosSubcategoria Producto[]  @relation("ProductoSubcategoria")

  @@index([clasSectionId])
  @@index([clasSpecificId])
}

model Unidad {
  unidadId  String     @id @default(cuid())
  nombre    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  simbolo   String
  productos Producto[]
}

model Vendor {
  vendorId         String            @id @default(cuid())
  nombre           String
  contacto         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contrato         String?
  cuentaCUP        String?
  cuentaUSD        String?
  direccion        String?
  logo             String?
  telefono         String?
  vendorCode       String?           @unique @db.VarChar(2)
  compras          CompraProducto[]
  compraDocumentos CompraDocumento[]
  contratos        Contrato[]        @relation("ContratoVendor")
  cuentasPorPagar  CuentaPorPagar[]
  deudasCash       DeudaCash[]
  gastoCompras     GastoCompra[]
  anticipos        Anticipo[]
  productos        Producto[]
  compraServicios  CompraServicio[]

  @@index([vendorCode])
}

model InyeccionCapital {
  id                 String         @id @default(cuid())
  tipo               TipoInyeccion
  montoRecibido      Decimal
  moneda             String         @default("CUP")
  tasaInteres        Decimal?
  montoInteres       Decimal?
  montoTotalDeuda    Decimal?
  saldoPendiente     Decimal?
  plazoMeses         Int?
  fechaInicioPago    DateTime?
  socio              String?
  entidadPrestamista String?
  cuentaId           String
  estado             EstadoDeuda?   @default(ACTIVA)
  descripcion        String?
  fechaRegistro      DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  cuentaBancaria     CuentaBancaria @relation(fields: [cuentaId], references: [cuentaId])
  pagos              PagoDeuda[]
}

model PagoDeuda {
  id             String           @id @default(cuid())
  inyeccionId    String
  montoPagado    Decimal
  fechaPago      DateTime         @default(now())
  cuentaId       String
  numeroCuota    Int?
  comprobante    String?
  observaciones  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cuentaBancaria CuentaBancaria   @relation(fields: [cuentaId], references: [cuentaId])
  inyeccion      InyeccionCapital @relation(fields: [inyeccionId], references: [id], onDelete: Cascade)
}

model Cliente {
  clienteId         String            @id @default(cuid())
  nombre            String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  direccion         String?
  logoUrl           String?
  numeroContrato    String?
  numeroCuentaCUP   String?
  numeroCuentaUSD   String?
  telefono          String?
  contratos         Contrato[]        @relation("ContratoCliente")
  cuentasPorCobrar  CuentaPorCobrar[]
  anticipos         Anticipo[]
  ofertas           Oferta[]
  ordenesReparacion OrdenReparacion[]
  prestamosCash     PrestamoCash[]
  Venta             Venta[]
  ventasServicios   VentaServicios[]
  facturas          Factura[]
}

model MiEmpresa {
  id                Int             @id @default(1)
  nombre            String          @default("Mi Empresa")
  propietario       String?
  direccion         String?
  telefono          String?
  email             String?
  carnetIdentidad   String?
  nit               String?
  licenciaOperacion String?
  logoUrl           String?
  cuentaBancariaId  String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  usaCodigoEan13    Boolean         @default(false)
  cuentaBancaria    CuentaBancaria? @relation("MiEmpresaCuenta", fields: [cuentaBancariaId], references: [cuentaId])
}

model Almacen {
  almacenId             String          @id @default(cuid())
  nombre                String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  productos             Producto[]
  transferenciasDestino Transferencia[] @relation("TransferenciasDestino")
  transferenciasOrigen  Transferencia[] @relation("TransferenciasOrigen")
}

model PuntoDeVenta {
  pvId                  String          @id @default(cuid())
  nombre                String
  ubicacion             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  listaPrecioId         String?
  productos             Producto[]
  listaPrecio           ListaPrecio?    @relation(fields: [listaPrecioId], references: [id])
  transferenciasDestino Transferencia[] @relation("TransferenciasDestino")
  transferenciasOrigen  Transferencia[] @relation("TransferenciasOrigen")
  ventas                Venta[]
}

model Producto {
  nombre               String
  descripcion          String?
  precioCosto          Int
  precioVenta          Int
  stock                Int
  categoriaId          String
  unidadId             String?
  vendorId             String?
  createdAt            DateTime                  @default(now())
  id                   String                    @id @default(cuid())
  updatedAt            DateTime                  @updatedAt
  esCompuesto          Boolean                   @default(false)
  almacenId            String
  puntoDeVentaId       String?
  stockMinimo          Int                       @default(0)
  subcategoriaId       String?
  cantidadEnPack       Int?
  productoPadreId      String?
  codigoInterno        String?                   @unique @db.VarChar(11)
  codigoNegocio        String?                   @unique
  proveedorCodigo      String?
  idSeccionCodigo      String?
  especificoCodigo     String?
  surtidoCodigo        String?
  dcCodigo             String?
  fotos                String[]                  @default([])
  compras              CompraProducto[]
  compraDocumentoItems CompraDocumentoItem[]
  gastoCompras         GastoCompra[]
  mermas               Merma[]
  ofertaItems          OfertaItem[]
  ordenMateriales      OrdenReparacionMaterial[]
  precios              PrecioProducto[]
  almacen              Almacen                   @relation(fields: [almacenId], references: [almacenId], onDelete: Cascade)
  categoria            Categoria                 @relation(fields: [categoriaId], references: [catId], onDelete: Cascade)
  puntoDeVenta         PuntoDeVenta?             @relation(fields: [puntoDeVentaId], references: [pvId], onDelete: Cascade)
  productoPadre        Producto?                 @relation("ProductoCompuesto", fields: [productoPadreId], references: [id])
  productosHijos       Producto[]                @relation("ProductoCompuesto")
  subcategoria         Categoria?                @relation("ProductoSubcategoria", fields: [subcategoriaId], references: [catId])
  unidad               Unidad?                   @relation(fields: [unidadId], references: [unidadId], onDelete: Cascade)
  vendor               Vendor?                   @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  costHistory          ProductoCostHistory[]
  Receta               Receta[]
  RecetaIngrediente    RecetaIngrediente[]
  transferencias       Transferencia[]
  ValeSalidaItem       ValeSalidaItem[]
  ventas               Venta[]
  ventaItems           VentaItem[]
  stockUbicaciones     StockUbicacion[]
}

model StockUbicacion {
  id                 String   @id @default(cuid())
  productoId         String
  tipoUbicacion      String // "almacen" | "punto_venta"
  ubicacionId        String // Almacen.almacenId o PuntoDeVenta.pvId
  cantidad           Int      @default(0)
  cantidadReservada  Int      @default(0)
  cantidadDisponible Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  producto           Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, tipoUbicacion, ubicacionId])
  @@index([ubicacionId, tipoUbicacion])
  @@index([productoId])
}

model Venta {
  ventaId          String                @id @default(cuid())
  productoId       String?
  cantidad         Int
  puntoDeVentaId   String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  empleadoId       String?
  total            Int?
  clienteId        String?
  ordenId          String?
  descuento        Int?
  observaciones    String?
  esVentaUnica     Boolean               @default(false)
  ofertaId         String?               @unique
  ventaPadreId     String?
  ordenReparacion  OrdenReparacion?      @relation("OrdenVenta")
  reconciliaciones ReconciliacionVenta[]
  cliente          Cliente?              @relation(fields: [clienteId], references: [clienteId], onDelete: Cascade)
  empleado         Empleado?             @relation(fields: [empleadoId], references: [empleadoId])
  oferta           Oferta?               @relation(fields: [ofertaId], references: [id])
  producto         Producto?             @relation(fields: [productoId], references: [id], onDelete: Cascade)
  puntoDeVenta     PuntoDeVenta          @relation(fields: [puntoDeVentaId], references: [pvId])
  factura          Factura?
  items            VentaItem[]
}

model VentaItem {
  id             String   @id @default(cuid())
  ventaId        String
  productoId     String
  cantidad       Int
  precioUnitario Int
  total          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  venta          Venta    @relation(fields: [ventaId], references: [ventaId], onDelete: Cascade)

  @@map("venta_items")
}

model Merma {
  mermaId    String   @id @default(cuid())
  productoId String
  cantidad   Int
  motivo     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  costoTotal Int?
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Transferencia {
  transferenciaId       String        @id @default(cuid())
  productoId            String
  cantidad              Int
  origenId              String?
  destinoId             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  descripcion           String?
  costoUnitario         Int?
  costoTotal            Int?
  deletedAt             DateTime?
  estado                String        @default("COMPLETADA")
  numeroTransferencia   String?       @unique
  creadoPorId           String?
  puntoDeVentaDestinoId String?
  puntoDeVentaOrigenId  String?
  destino               Almacen?      @relation("TransferenciasDestino", fields: [destinoId], references: [almacenId])
  origen                Almacen?      @relation("TransferenciasOrigen", fields: [origenId], references: [almacenId])
  producto              Producto      @relation(fields: [productoId], references: [id], onDelete: Cascade)
  creadoPor             User?         @relation(fields: [creadoPorId], references: [userId], onDelete: SetNull)
  puntoDeVentaDestino   PuntoDeVenta? @relation("TransferenciasDestino", fields: [puntoDeVentaDestinoId], references: [pvId])
  puntoDeVentaOrigen    PuntoDeVenta? @relation("TransferenciasOrigen", fields: [puntoDeVentaOrigenId], references: [pvId])
}

model User {
  userId                   String               @id @default(cuid())
  name                     String
  email                    String               @unique
  password                 String
  role                     String               @default("regularUser")
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  activatedAt              DateTime?
  avatar                   String?
  expiresAt                DateTime?
  isActive                 Boolean              @default(true)
  lastFailedLogin          DateTime?
  lastModifiedBy           String?
  lockedUntil              DateTime?
  loginAttempts            Int                  @default(0)
  contratosAprobados       Contrato[]           @relation("AprobadorContrato")
  contratosCreados         Contrato[]           @relation("CreadorContrato")
  contratoAprobaciones     ContratoAprobacion[]
  contratoArchivos         ContratoArchivo[]
  contratoFirmas           ContratoFirma[]
  contratoVersiones        ContratoVersion[]
  tiposContratosCustom     TipoContratoCustom[]
  licencias                Licencia[]
  licenciasAudit           LicenciaAudit[]      @relation("LicenciaAuditActor")
  notifications            Notification[]
  activityLogs             UserActivityLog[]
  sessions                 UserSession[]
  anticiposCreados         Anticipo[]
  compraDocumentosEditados CompraDocumento[]    @relation("CompraDocumentoActualizado")
  transferenciasCreadas    Transferencia[]
}

model Plan {
  planId       String     @id @default(cuid())
  nombre       String
  descripcion  String?
  precio       Decimal    @default(0)
  duracionDias Int
  maxUsuarios  Int        @default(1)
  maxAlmacenes Int        @default(1)
  maxProductos Int        @default(100)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  licencias    Licencia[]
}

model Licencia {
  licenciaId String          @id @default(cuid())
  clave      String          @unique
  usuarioId  String
  planId     String
  activa     Boolean         @default(true)
  inicio     DateTime        @default(now())
  expiracion DateTime
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  plan       Plan            @relation(fields: [planId], references: [planId], onDelete: Cascade)
  usuario    User            @relation(fields: [usuarioId], references: [userId], onDelete: Cascade)
  auditoria  LicenciaAudit[]

  @@index([usuarioId])
  @@index([planId])
}

model LicenciaAudit {
  licenciaId      String
  accion          String
  detalles        String?
  realizadoPor    String?
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())
  licenciaAuditId String   @id @default(cuid())
  licencia        Licencia @relation(fields: [licenciaId], references: [licenciaId], onDelete: Cascade)
  actor           User?    @relation("LicenciaAuditActor", fields: [realizadoPor], references: [userId])

  @@index([licenciaId])
  @@index([realizadoPor])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  userId    String
  prioridad String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model UserActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  details     String?
  ipAddress   String?
  userAgent   String?
  performedBy String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  ipAddress  String?
  userAgent  String?
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastActive DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model Attendance {
  attendanceId   String    @id @default(cuid())
  employeeId     String
  date           DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  totalHours     Decimal?  @db.Decimal(5, 2)
  status         String    @default("present")
  manualCheckIn  DateTime?
  manualCheckOut DateTime?
  isManualEntry  Boolean   @default(false)
  notes          String?
  scheduledHours Decimal?  @db.Decimal(4, 2)
  overtimeHours  Decimal?  @db.Decimal(4, 2)
  breakHours     Decimal?  @db.Decimal(3, 2)
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       Empleado  @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)
}

model EmployeeWorkSchedule {
  scheduleId     String   @id @default(cuid())
  employeeId     String
  dayOfWeek      Int
  startTime      String
  endTime        String
  breakStartTime String?
  breakEndTime   String?
  isWorkingDay   Boolean  @default(true)
  scheduledHours Decimal  @db.Decimal(4, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Empleado @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
}

model VacationRequest {
  requestId     String    @id @default(cuid())
  employeeId    String
  startDate     DateTime
  endDate       DateTime
  daysRequested Int
  reason        String?
  status        String    @default("pending")
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Empleado  @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)
}

/// *
/// * Modelo para registro de acumulación automática de vacaciones
model VacationAccrual {
  accrualId              String   @id @default(cuid())
  employeeId             String
  periodo                String
  diasAcumulados         Int
  diasPorAntiguedad      Int
  diasPorTiempoTrabajado Int
  tipoAcumulacion        String
  fechaCalculo           DateTime @default(now())
  procesado              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  employee               Empleado @relation(fields: [employeeId], references: [empleadoId], onDelete: Cascade)
}

model Empleado {
  empleadoId            String                 @id @default(cuid())
  nombre                String
  apellido              String
  telefono              String?
  cargo                 String
  salarioBases          Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  diasVacacionesAnuales Int                    @default(15)
  esTiempoCompleto      Boolean                @default(true)
  fechaContratacion     DateTime
  vacationDaysAccrued   Int                    @default(0)
  vacationDaysUsed      Int                    @default(0)
  attendances           Attendance[]
  workSchedules         EmployeeWorkSchedule[]
  ordenesAsignadas      OrdenReparacion[]
  PagoSalario           Pagosalario[]
  vacationAccruals      VacationAccrual[]
  vacationRequests      VacationRequest[]
  ventas                Venta[]
}

model Pagosalario {
  pgId                String                @id @default(cuid())
  empleadoId          String
  salario             Int
  bonificaciones      Int?                  @default(0)
  deducciones         Int?                  @default(0)
  horasExtras         Int?                  @default(0)
  observaciones       String?
  periodo             String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  empleado            Empleado              @relation(fields: [empleadoId], references: [empleadoId], onDelete: Cascade)
  ReconciliacionGasto ReconciliacionGasto[]
}

model CierreContable {
  cierreId            String   @id @default(cuid())
  tipo                String
  fechaInicio         DateTime
  fechaFin            DateTime
  totalVentas         Decimal  @default(0)
  totalGastos         Decimal  @default(0)
  ganancias           Decimal  @default(0)
  perdidas            Decimal  @default(0)
  ingresosCaja        Decimal  @default(0)
  egresosCaja         Decimal  @default(0)
  deudasClientes      Decimal  @default(0)
  deudasProveedores   Decimal  @default(0)
  inventarioVendido   Int      @default(0)
  inventarioRebajado  Int      @default(0)
  stockFinal          Int      @default(0)
  margenGanancia      Decimal  @default(0)
  margenPerdida       Decimal  @default(0)
  ventasVsExistencias String?
  estado              String   @default("abierto")
  creadoPor           String
  aprobadoPor         String?
  observaciones       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model GastoCompra {
  gastoCompraId    String                @id @default(cuid())
  productoId       String
  vendorId         String
  cantidad         Int
  precioUnitario   Int
  total            Int
  fechaCompra      DateTime              @default(now())
  descripcion      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  periodo          String?
  numeroFactura    String?
  deletedAt        DateTime?
  compraProducto   CompraProducto?
  compraDocumento  CompraDocumento?
  cuentaPorPagar   CuentaPorPagar?
  producto         Producto              @relation(fields: [productoId], references: [id], onDelete: Cascade)
  vendor           Vendor                @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  reconciliaciones ReconciliacionGasto[]
}

model CompraProducto {
  compraProductoId String          @id @default(cuid())
  productoId       String
  numeroFactura    String
  facturaUrl       String
  cantidad         Int
  precioUnitario   Int
  total            Int
  descripcion      String?
  fechaCompra      DateTime        @default(now())
  gastoCompraId    String?         @unique
  cuentaPorPagarId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  proveedorId      String
  formaPago        String
  estado           String
  tipoOperacion    String          @default("REGULAR")
  deletedAt        DateTime?
  updatedById      String?
  cuentaPorPagar   CuentaPorPagar? @relation(fields: [cuentaPorPagarId], references: [cuentaPorPagarId])
  gastoCompra      GastoCompra?    @relation(fields: [gastoCompraId], references: [gastoCompraId])
  anticipo         Anticipo?
  producto         Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)
  proveedor        Vendor          @relation(fields: [proveedorId], references: [vendorId], onDelete: Cascade)

  @@index([estado])
  @@index([proveedorId])
  @@index([productoId])
  @@index([deletedAt])
}

/// * Cabecera de compra múltiple. Una factura/proveedor → N items.
model CompraDocumento {
  compraDocumentoId String                @id @default(cuid())
  proveedorId       String
  numeroFactura     String                @default("")
  facturaUrl        String                @default("")
  formaPago         String
  estado            String
  tipoOperacion     String                @default("REGULAR")
  descripcion       String?
  fechaCompra       DateTime              @default(now())
  total             Int                   @default(0)
  gastoCompraId     String?               @unique
  cuentaPorPagarId  String?               @unique
  deletedAt         DateTime?
  updatedById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  cuentaPorPagar    CuentaPorPagar?       @relation(fields: [cuentaPorPagarId], references: [cuentaPorPagarId])
  gastoCompra       GastoCompra?          @relation(fields: [gastoCompraId], references: [gastoCompraId])
  proveedor         Vendor                @relation(fields: [proveedorId], references: [vendorId], onDelete: Cascade)
  updatedBy         User?                 @relation("CompraDocumentoActualizado", fields: [updatedById], references: [userId], onDelete: SetNull)
  items             CompraDocumentoItem[]

  @@index([estado])
  @@index([proveedorId])
  @@index([fechaCompra])
  @@index([deletedAt])
}

/// * Línea de detalle de una compra múltiple.
model CompraDocumentoItem {
  compraDocumentoItemId String          @id @default(cuid())
  compraDocumentoId     String
  productoId            String
  cantidad              Int
  precioUnitario        Int
  totalLinea            Int
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  compraDocumento       CompraDocumento @relation(fields: [compraDocumentoId], references: [compraDocumentoId], onDelete: Cascade)
  producto              Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([compraDocumentoId])
  @@index([productoId])
}

model Servicios {
  servicioId      String           @id @default(cuid())
  nombre          String
  precio          Int
  descripcion     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ofertaItems     OfertaItem[]
  ventasServicios VentaServicios[]
  compraServicios CompraServicio[]
}

model VentaServicios {
  ventaServicioId  String                   @id @default(cuid())
  servicioId       String
  cantidad         Int
  total            Int
  observaciones    String?
