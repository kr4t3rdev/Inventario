describe("Scheduled Reports - Casos Edge", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("debe validar frecuencia semanal con día de semana", () => {
    const frecuenciasValidas = ["diaria", "semanal", "quincenal", "mensual"];
    expect(frecuenciasValidas).toContain("semanal");
  });

  it("debe validar frecuencia mensual con día del mes", () => {
    const frecuenciasValidas = ["diaria", "semanal", "quincenal", "mensual"];
    expect(frecuenciasValidas).toContain("mensual");
  });

  it("debe calcular próxima ejecución diaria correctamente", () => {
    const frecuencia = "diaria";
    const hora = "08:00";
    const ahora = new Date();

    const [hours, minutes] = hora.split(":").map(Number);
    const proxima = new Date(ahora);
    proxima.setHours(hours, minutes, 0, 0);

    if (proxima <= ahora) {
      proxima.setDate(proxima.getDate() + 1);
    }

    expect(proxima.getHours()).toBe(8);
    expect(proxima.getMinutes()).toBe(0);
  });

  it("debe calcular próxima ejecución semanal correctamente", () => {
    const frecuencia = "semanal";
    const diaSemana = 1; // Lunes
    const hora = "08:00";

    const ahora = new Date();
    const [hours, minutes] = hora.split(":").map(Number);
    const proxima = new Date(ahora);
    proxima.setHours(hours, minutes, 0, 0);

    const diaActual = proxima.getDay();
    const diasParaSumar = ((diaSemana - diaActual + 7) % 7) || 7;
    proxima.setDate(proxima.getDate() + diasParaSumar);

    expect(proxima.getDay()).toBe(1);
  });

  it("debe calcular próxima ejecución mensual correctamente", () => {
    const frecuencia = "mensual";
    const diaMes = 15;
    const hora = "08:00";

    const ahora = new Date();
    const [hours, minutes] = hora.split(":").map(Number);
    const proxima = new Date(ahora);
    proxima.setHours(hours, minutes, 0, 0);

    const diaDelMes = proxima.getDate();
    const ultimoDiaMes = new Date(proxima.getFullYear(), proxima.getMonth() + 1, 0).getDate();
    const diaObjetivo = Math.min(diaMes, ultimoDiaMes);

    if (diaDelMes < diaObjetivo) {
      proxima.setDate(diaObjetivo);
    } else {
      proxima.setMonth(proxima.getMonth() + 1);
      const nuevoUltimoDia = new Date(proxima.getFullYear(), proxima.getMonth() + 1, 0).getDate();
      proxima.setDate(Math.min(diaMes, nuevoUltimoDia));
    }

    expect(proxima.getDate()).toBeGreaterThanOrEqual(15);
  });

  it("debe validar formatos de reporte", () => {
    const formatosValidos = ["PDF", "CSV", "EXCEL"];
    expect(formatosValidos).toContain("PDF");
    expect(formatosValidos).toContain("CSV");
    expect(formatosValidos).toContain("EXCEL");
  });

  it("debe validar tipos de reporte", () => {
    const tiposValidos = ["COMPLETO", "COST_IMPACT", "DEBT_EXPOSURE", "PAYMENT_EFFICIENCY", "KPI"];
    expect(tiposValidos).toContain("COMPLETO");
    expect(tiposValidos).toContain("KPI");
  });
});

